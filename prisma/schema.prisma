model Campaign {
  id               String           @id @default(cuid())
  projectId        String
  ownerId          String
  name             String
  description      String?
  objective        String?
  audience         String?
  productOrService String?
  startDate        DateTime?
  endDate          DateTime?
  platforms        SocialPlatform[] @default([])
  frequency        String?
  budget           Decimal?         @db.Decimal(12, 2)
  primaryCTA       String?
  links            String[]         @default([])
  tags             String[]         @default([])
  status           CampaignStatus   @default(DRAFT)

  // --- AI Campaign Studio (Fase 28) — briefing fields, additive ------------
  timezone           String   @default("UTC")
  brandProfileId     String?
  valueProposition   String?
  mainMessage        String?
  offer              String?
  tone               String?
  forbiddenWords     String[] @default([])
  differentiators    String[] @default([])
  audienceLocation   String?
  audienceAgeRange   String?
  audienceInterests  String[] @default([])
  audiencePainPoints String[] @default([])
  audienceNeeds      String[] @default([])
  audienceObjections String[] @default([])
  audienceAwareness  String?
  /// Free-form channel ids for this campaign's wizard step 4 — broader than
  /// the SocialPlatform enum (adds "blog"/"email"/"newsletter", which are
  /// real repurposing/publishing targets but never become a SocialPost).
  /// See src/lib/campaign-studio/channels.ts for the fixed id list.
  channels           String[] @default([])
  contentCount       Int?
  frequencyPerWeek   Int?
  preferredDays      String[] @default([])
  preferredHours     String[] @default([])
  desiredFormats     String[] @default([])
  /// Set when this campaign was created from a CampaignTemplate — informational only, never a live reference back into the template's own lifecycle.
  templateSourceId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project                    Project                             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner                      User                                @relation("CampaignOwner", fields: [ownerId], references: [id])
  brandProfile               BrandProfile?                       @relation(fields: [brandProfileId], references: [id], onDelete: SetNull)
  contents                   CampaignContent[]
  posts                      SocialPost[]
  strategy                   CampaignStrategy?
  pillars                    CampaignPillar[]
  pieces                     CampaignContentPiece[]
  metricGoals                CampaignMetricGoal[]
  marketingBrainRuns         MarketingBrainRun[]                 @relation("MarketingBrainRunCampaign")
  marketingBrainResources    MarketingBrainResource[]            @relation("MarketingBrainResourceCampaign")
  aiAgentResources           AiAgentResource[]                   @relation("AiAgentResourceCampaign")
  knowledgeSources           KnowledgeSource[]
  performanceMetricRecords   PerformanceMetricRecord[]
  performanceGoals           PerformanceGoal[]
  performanceBenchmarks      PerformanceBenchmark[]
  performanceExperiments     PerformanceExperiment[]
  performanceRecommendations PerformanceRecommendation[]
  performanceAnomalies       PerformanceAnomaly[]
  performanceReportResources PerformanceReportResource[]
  mbOptimizationSessions     MarketingBrainOptimizationSession[]
  mbMeasurementPlans         MarketingBrainMeasurementPlan[]

  @@index([projectId, status])
}

model CampaignContent {
  campaignId    String
  contentItemId String

  campaign    Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contentItem ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)

  @@id([campaignId, contentItemId])
}

// ---------------------------------------------------------------------------
// AI Campaign Studio (Fase 28) — structured strategy, pillars, planned
// pieces, comments, metric goals, templates. Every section that needs
// individual search/relations/updates (strategy fields, pillars, pieces,
// comments, metrics) is its own column/model — Json is used ONLY for
// CampaignStrategyVersion.snapshot (an immutable point-in-time copy, same
// role ContentVersion.body plays for content) and CampaignTemplate.structure
// (a flexible blueprint expanded wholesale on instantiation, never queried
// section-by-section).
// ---------------------------------------------------------------------------

model CampaignStrategy {
  id               String    @id @default(cuid())
  campaignId       String    @unique
  summary          String?   @db.Text
  audienceProfile  String?   @db.Text
  valueProposition String?   @db.Text
  mainMessage      String?   @db.Text
  objectives       String[]  @default([])
  themes           String[]  @default([])
  creativeAngles   String[]  @default([])
  cta              String?
  risks            String[]  @default([])
  recommendations  String[]  @default([])
  suggestedMetrics String[]  @default([])
  generatedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  campaign         Campaign                  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  versions         CampaignStrategyVersion[]
  aiAgentResources AiAgentResource[]
  knowledgeSources KnowledgeSource[]
}

model CampaignStrategyVersion {
  id         String   @id @default(cuid())
  strategyId String
  authorId   String
  /// Full structured snapshot at save time — see the file-level note above on why this one field is JSON.
  snapshot   Json
  note       String?
  createdAt  DateTime @default(now())

  strategy CampaignStrategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  author   User             @relation("CampaignStrategyVersionAuthor", fields: [authorId], references: [id])

  @@index([strategyId])
}

model CampaignPillar {
  id          String   @id @default(cuid())
  campaignId  String
  name        String
  description String?
  objective   String?
  color       String?
  percentage  Int?
  formats     String[] @default([])
  platforms   String[] @default([])
  topics      String[] @default([])
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  campaign                Campaign                 @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  pieces                  CampaignContentPiece[]
  marketingBrainResources MarketingBrainResource[]
  aiAgentResources        AiAgentResource[]

  @@index([campaignId, order])
}

model CampaignContentPiece {
  id            String                @id @default(cuid())
  campaignId    String
  pillarId      String?
  /// Set once "Crear contenido" turns this planned piece into a real ContentItem — see createContentFromPieceAction.
  contentItemId String?               @unique
  title         String
  idea          String?               @db.Text
  platform      String
  format        String?
  objective     String?
  cta           String?
  scheduledDate DateTime?
  scheduledTime String?
  status        CampaignPieceStatus   @default(IDEA)
  priority      CampaignPiecePriority @default(MEDIUM)
  assigneeId    String?
  authorId      String
  updatedById   String?
  keywords      String[]              @default([])
  notes         String?               @db.Text
  /// Persisted Kanban card order within its status column.
  order         Int                   @default(0)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  campaign                         Campaign                          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  pillar                           CampaignPillar?                   @relation(fields: [pillarId], references: [id], onDelete: SetNull)
  contentItem                      ContentItem?                      @relation(fields: [contentItemId], references: [id], onDelete: SetNull)
  assignee                         User?                             @relation("CampaignPieceAssignee", fields: [assigneeId], references: [id])
  author                           User                              @relation("CampaignPieceAuthor", fields: [authorId], references: [id])
  updatedBy                        User?                             @relation("CampaignPieceUpdatedBy", fields: [updatedById], references: [id])
  comments                         CampaignPieceComment[]
  socialPosts                      SocialPost[]
  marketingBrainResources          MarketingBrainResource[]
  aiAgentResources                 AiAgentResource[]
  knowledgeSources                 KnowledgeSource[]
  performanceMetricRecords         PerformanceMetricRecord[]
  performanceRecommendationActions PerformanceRecommendationAction[]
  mbScenarioActions                MarketingBrainScenarioAction[]

  @@index([campaignId, status])
  @@index([campaignId, order])
  @@index([assigneeId])
}

model CampaignPieceComment {
  id               String   @id @default(cuid())
  pieceId          String
  authorId         String
  body             String   @db.Text
  resolved         Boolean  @default(false)
  mentionedUserIds String[] @default([])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  piece  CampaignContentPiece @relation(fields: [pieceId], references: [id], onDelete: Cascade)
  author User                 @relation("CampaignPieceCommentAuthor", fields: [authorId], references: [id])

  @@index([pieceId])
}

model CampaignMetricGoal {
  id           String             @id @default(cuid())
  campaignId   String
  metricType   CampaignMetricType
  targetValue  Decimal            @db.Decimal(14, 2)
  currentValue Decimal            @default(0) @db.Decimal(14, 2)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, metricType])
}

model CampaignTemplate {
  id          String   @id @default(cuid())
  projectId   String
  createdById String
  name        String
  description String?
  /// Blueprint snapshot (channels, frequency, pillars, objectives, checklist, formats, base strategy) — see the file-level note above on why this is Json.
  structure   Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User    @relation("CampaignTemplateCreatedBy", fields: [createdById], references: [id])

  @@index([projectId])
}

// ---------------------------------------------------------------------------
// Social posts
// ---------------------------------------------------------------------------

model SocialPost {
  id              String           @id @default(cuid())
  projectId       String
  authorId        String
  campaignId      String?
  sourceContentId String?
  platform        SocialPlatform
  postType        String
  internalTitle   String?
  text            String           @db.Text
  status          SocialPostStatus @default(IDEA)
  scheduledAt     DateTime?
  timezone        String           @default("UTC")
  tags            String[]         @default([])
  cta             String?
  hashtags        String[]         @default([])
  link            String?
  notes           String?
  result          String?
  publishedAt     DateTime?
  externalId      String?

  // --- AI Social Publishing Hub (Fase 29) — additive ------------------------
  format            String?
  firstComment      String?               @db.Text
  altText           String?
  priority          CampaignPiecePriority @default(MEDIUM)
  brandProfileId    String?
  /// Who should carry out/own this publication — distinct from `authorId` (who created the draft).
  assigneeId        String?
  /// Who is DESIGNATED to review/approve this publication — set before any approval happens.
  approverId        String?
  /// Who actually approved it (may be null even if approverId is set, until approval happens) — kept separate from approverId for an honest audit trail.
  approvedById      String?
  approvedAt        DateTime?
  /// Per-post checklist completion — { [itemId]: boolean }. See src/lib/publishing/checklists.ts. The item DEFINITIONS live in PublishingChecklistTemplate/the built-in defaults, never here.
  checklistState    Json?
  sourcePieceId     String?
  templateSourceId  String?
  seriesId          String?
  /// Kanban/queue-ordering position — see reorderPublicationQueueAction.
  queuePosition     Int?
  isPaused          Boolean               @default(false)
  attemptCount      Int                   @default(0)
  lastAttemptAt     DateTime?
  nextAttemptAt     DateTime?
  lastErrorProvider String?
  lastErrorCode     String?
  /// Always a SAFE, user-facing message — never a raw provider response or a token. See src/lib/publishing/providers/types.ts.
  lastErrorMessage  String?
  isRetryable       Boolean?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project                          Project                           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author                           User                              @relation("SocialPostAuthor", fields: [authorId], references: [id])
  campaign                         Campaign?                         @relation(fields: [campaignId], references: [id])
  sourceContent                    ContentItem?                      @relation("SocialPostSourceContent", fields: [sourceContentId], references: [id])
  brandProfile                     BrandProfile?                     @relation(fields: [brandProfileId], references: [id], onDelete: SetNull)
  assignee                         User?                             @relation("SocialPostAssignee", fields: [assigneeId], references: [id])
  approver                         User?                             @relation("SocialPostApprover", fields: [approverId], references: [id])
  approvedBy                       User?                             @relation("SocialPostApprovedBy", fields: [approvedById], references: [id])
  sourcePiece                      CampaignContentPiece?             @relation(fields: [sourcePieceId], references: [id], onDelete: SetNull)
  series                           PublicationSeries?                @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  versions                         SocialPostVersion[]
  metrics                          SocialMetric[]
  mediaAssets                      FileAsset[]
  media                            PublicationMedia[]
  attempts                         PublicationAttempt[]
  approvalEvents                   PublicationApprovalEvent[]
  marketingBrainResources          MarketingBrainResource[]
  aiAgentResources                 AiAgentResource[]
  knowledgeSources                 KnowledgeSource[]
  performanceMetricRecords         PerformanceMetricRecord[]
  performanceExperimentVariants    PerformanceExperimentVariant[]
  performanceRecommendations       PerformanceRecommendation[]
  performanceRecommendationActions PerformanceRecommendationAction[]
  performanceAnomalies             PerformanceAnomaly[]
  performanceReportResources       PerformanceReportResource[]
  mbScenarioActions                MarketingBrainScenarioAction[]
  mbMeasurementPlans               MarketingBrainMeasurementPlan[]

  @@index([projectId, status])
  @@index([projectId, scheduledAt])
  @@index([campaignId])
  @@index([sourcePieceId])
  @@index([assigneeId])
  @@index([approverId])
  @@index([seriesId])
  @@index([projectId, queuePosition])
}

// ---------------------------------------------------------------------------
// AI Social Publishing Hub (Fase 29) — media reuse, approval history,
// publish attempts/errors, recurrence series, templates, and per-platform
// checklist configuration. Every field that needs individual search,
// relations, or updates is a real column/model; Json is used ONLY for
// PublicationTemplate.structure and PublishingChecklistTemplate.items (both
// flexible, whole-unit configuration, never queried field-by-field) and
// SocialPost.checklistState (a per-post completion map, same precedent as
// ContentItem.publishChecklist from Fase 27).
// ---------------------------------------------------------------------------

model PublicationMedia {
  id              String   @id @default(cuid())
  socialPostId    String
  fileAssetId     String
  order           Int      @default(0)
  /// Overrides FileAsset.altText for this specific placement, when set — the asset's own alt text is the default.
  altTextOverride String?
  createdAt       DateTime @default(now())

  socialPost SocialPost @relation(fields: [socialPostId], references: [id], onDelete: Cascade)
  fileAsset  FileAsset  @relation(fields: [fileAssetId], references: [id], onDelete: Cascade)

  @@unique([socialPostId, fileAssetId])
  @@index([socialPostId, order])
}

model PublicationApprovalEvent {
  id           String                    @id @default(cuid())
  socialPostId String
  actorId      String
  action       PublicationApprovalAction
  comment      String?                   @db.Text
  createdAt    DateTime                  @default(now())

  socialPost SocialPost @relation(fields: [socialPostId], references: [id], onDelete: Cascade)
  actor      User       @relation(fields: [actorId], references: [id])

  @@index([socialPostId, createdAt])
}

model PublicationAttempt {
  id            String                   @id @default(cuid())
  socialPostId  String
  /// Provider adapter id (e.g. "meta", "tiktok", "linkedin", "youtube", "x", "pinterest", "wordpress", "email") — see src/lib/publishing/providers/types.ts.
  provider      String
  attemptNumber Int
  status        PublicationAttemptStatus @default(WAITING)
  errorCode     String?
  /// Always a SAFE, user-facing message — never a raw provider response, header, or token.
  errorMessage  String?                  @db.Text
  isRetryable   Boolean?
  nextAttemptAt DateTime?
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime                 @default(now())

  socialPost SocialPost @relation(fields: [socialPostId], references: [id], onDelete: Cascade)

  @@index([socialPostId, createdAt])
}

model PublicationSeries {
  id              String              @id @default(cuid())
  projectId       String
  createdById     String
  frequency       RecurrenceFrequency
  /// Used only when frequency is SPECIFIC_DAYS — e.g. ["MON", "WED", "FRI"].
  daysOfWeek      String[]            @default([])
  /// Used only when frequency is CUSTOM_INTERVAL — days between occurrences.
  intervalDays    Int?
  startDate       DateTime
  endDate         DateTime?
  lastGeneratedAt DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User         @relation(fields: [createdById], references: [id])
  posts     SocialPost[]

  @@index([projectId])
}

model PublicationTemplate {
  id          String         @id @default(cuid())
  projectId   String
  createdById String
  name        String
  description String?
  platform    SocialPlatform
  /// Flexible blueprint (format, CTA, hashtags, firstComment, checklist reference, optional Brand Profile, approval config) — see the file-level note above on why this is Json.
  structure   Json
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User    @relation(fields: [createdById], references: [id])

  @@index([projectId])
}

model PublishingChecklistTemplate {
  id            String         @id @default(cuid())
  projectId     String
  platform      SocialPlatform
  /// Array of { id, label } — a flexible, whole-unit-edited config list, never queried item-by-item. See src/lib/publishing/checklists.ts for the built-in defaults this can override.
  items         Json
  blocksPublish Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

