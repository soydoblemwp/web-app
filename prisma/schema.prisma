  /// Publishing Hub (Fase 29) — project-wide editorial policy. See src/server/actions/publishing.ts's requireApprovalGate.
  requireApprovalBeforePublish Boolean       @default(false)
  allowSelfApproval            Boolean       @default(true)
  createdAt                    DateTime      @default(now())
  updatedAt                    DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  members                          ProjectMember[]
  brandKit                         BrandKit?
  contentItems                     ContentItem[]
  folders                          Folder[]
  tags                             Tag[]
  campaigns                        Campaign[]
  socialPosts                      SocialPost[]
  socialConnections                SocialPlatformConnection[]
