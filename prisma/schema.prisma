// ---------------------------------------------------------------------------
// Google Integrations Hub (Fase 39) — real OAuth 2.0 authorization-code flow
// for GA4 + Search Console, read-only scopes only. Metrics land in the EXACT
// SAME PerformanceMetricRecord table every other source uses (source:
// EXTERNAL_PROVIDER, provider: "ga4"/"gsc") — no second metrics store.
// ---------------------------------------------------------------------------

enum GoogleConnectionStatus {
  NOT_CONFIGURED
  AVAILABLE
  CONNECTING
  CONNECTED
  SYNCING
  PAUSED
  REAUTH_REQUIRED
  ERROR
  DISCONNECTED
}

enum GoogleResourceType {
  GA4_PROPERTY
  SEARCH_CONSOLE_SITE
}

enum GoogleSyncType {
  INITIAL
  INCREMENTAL
  MANUAL
  RESYNC
}

enum GoogleSyncStatus {
  PENDING
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
  CANCELLED
}

/// One real Google OAuth connection per project (one Google account can grant both GA4 and Search Console access). Tokens are encrypted via encryptSecret/decryptSecret, never stored or returned in plaintext (spec section 8).
model GoogleIntegrationConnection {
  id                    String                 @id @default(cuid())
  projectId             String                 @unique
  connectedById         String
  googleEmail           String?
  status                GoogleConnectionStatus @default(NOT_CONFIGURED)
  scopes                String[]               @default([])
  encryptedAccessToken  String?                @db.Text
  encryptedRefreshToken String?                @db.Text
  tokenExpiresAt        DateTime?
  connectedAt           DateTime?
  disconnectedAt        DateTime?
  lastUsedAt            DateTime?
  pausedAt              DateTime?
  /// Sanitized, human-readable summary only — never the raw provider error body (spec section 22).
  lastError             String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  project     Project                     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  connectedBy User                        @relation("GoogleIntegrationConnectionConnectedBy", fields: [connectedById], references: [id])
  resources   GoogleIntegrationResource[]
  syncRuns    GoogleIntegrationSyncRun[]

  @@index([projectId, status])
}

/// A real, user-confirmed GA4 property or Search Console site selected for sync — never auto-selected, never inferred (spec section 11-12).
model GoogleIntegrationResource {
  id              String             @id @default(cuid())
  connectionId    String
  projectId       String
  type            GoogleResourceType
  /// GA4: "properties/123456789". Search Console: the exact site identifier Google returned (domain: or URL-prefix property) — never destructively normalized (spec section 12).
  externalId      String
  name            String
  url             String?
  accountName     String?
  permissionLevel String?
  active          Boolean            @default(true)
  discoveredAt    DateTime           @default(now())
  lastSyncedAt    DateTime?
  /// { periodDays, extraDimensions? } — validated by Zod before persisting, never trusted raw from the client (spec section 34).
  importConfig    Json?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  connection GoogleIntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  project    Project                     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  syncRuns   GoogleIntegrationSyncRun[]

  @@unique([connectionId, type, externalId])
  @@index([projectId, type, active])
}

/// One real sync attempt for one resource. Atomic claim via lockedAt/lockExpiresAt (spec section 35) — never a plain count()-then-create().
model GoogleIntegrationSyncRun {
  id             String           @id @default(cuid())
  projectId      String
  connectionId   String
  resourceId     String
  syncType       GoogleSyncType
  status         GoogleSyncStatus @default(PENDING)
  periodStart    DateTime
  periodEnd      DateTime
  cursor         String?
  rowsReceived   Int              @default(0)
  pointsCreated  Int              @default(0)
  pointsUpdated  Int              @default(0)
  pointsSkipped  Int              @default(0)
  /// Sanitized summary only — never the raw Google response body (spec section 22).
  errorMessage   String?
  errorCategory  String?
  startedAt      DateTime?
  completedAt    DateTime?
  startedById    String?
  idempotencyKey String           @unique
  lockedAt       DateTime?
  lockExpiresAt  DateTime?
  executionToken String?
  createdAt      DateTime         @default(now())

  project    Project                     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  connection GoogleIntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  resource   GoogleIntegrationResource   @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  startedBy  User?                       @relation("GoogleIntegrationSyncRunStartedBy", fields: [startedById], references: [id], onDelete: SetNull)

  @@index([projectId, status])
  @@index([resourceId, createdAt])
  @@index([connectionId, createdAt])
}

/// Short-lived, single-use, CSRF-protected OAuth state (spec sections 5-6, 33). The callback NEVER trusts projectId from the URL alone — it's always resolved from this row.
model GoogleOAuthState {
  id                    String    @id @default(cuid())
  projectId             String
  userId                String
  /// SHA-256 hash of the actual state value sent to Google — the raw value is never persisted.
  stateHash             String    @unique
  /// Encrypted via encryptSecret — the PKCE code_verifier, present only when PKCE is used.
  encryptedCodeVerifier String?   @db.Text
  expiresAt             DateTime
  consumedAt            DateTime?
  createdAt             DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation("GoogleOAuthStateUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([expiresAt])
}

