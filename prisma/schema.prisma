  userId          String
  name            String
  description     String?
  mission         String?
  vision          String?
  values          String[] @default([])
  targetAudience  String?
  tone            String?
  personality     String?
  primaryLanguage String?
  country         String?
  allowedWords    String[] @default([])
  forbiddenWords  String[] @default([])
  writingStyle    String?
  preferredCTAs   String[] @default([])
  socialLinks     String[] @default([])
  website         String?
  email           String?
  colors          String[] @default([])
