/// Custom email-verification token for the Credentials-based registration
/// flow — distinct from the standard `VerificationToken` model above, which
/// belongs to @auth/prisma-adapter's built-in (unused in this app) magic-link
/// Email provider and doesn't fit this flow: no FK to User (so no cascade
/// cleanup), no createdAt (needed for resend cooldown/"invalidate previous
/// tokens"), and a compound [identifier, token] unique instead of a single
/// direct-lookup key. Only `tokenHash` (never the raw token) is ever
/// persisted — see src/lib/auth/verification-token.ts. At most one row
/// exists per user at a time: every issuance (register or resend) deletes
/// any prior row for that user first, inside the same transaction.
model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  /// Set atomically on successful verification instead of deleting the row,
  /// so a repeat visit to the same link can show a distinct "ya utilizado"
  /// message rather than collapsing into the same "invalid" state a
  /// token that never existed would show. See verifyEmailToken's
  /// updateMany({ where: { usedAt: null } }) guard — also what makes
  /// consuming a token race-safe (concurrent uses of the same link).
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

