// AI Content Hub — Prisma schema
// Postgres (Neon) datasource, driver-adapter based client (Prisma 7).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

