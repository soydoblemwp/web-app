// Plans, subscriptions & usage limits
// ---------------------------------------------------------------------------

model Plan {
  id                         String   @id @default(cuid())
  tier                       PlanTier @unique
  name                       String
  maxProjects                Int
  maxMembers                 Int
  maxAIGenerationsPerMonth   Int
  maxAITokensPerMonth        Int
  maxAutomations             Int
  maxMonitors                Int
  minMonitorFrequencyMinutes Int
  maxIntegrations            Int
  maxStorageMb               Int
  maxCampaigns               Int
  priceMonthlyCents          Int      @default(0)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id                 String    @id @default(cuid())
  workspaceId        String    @unique
  planId             String
  isActive           Boolean   @default(true)
  currentPeriodStart DateTime  @default(now())
  currentPeriodEnd   DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  plan      Plan      @relation(fields: [planId], references: [id])
}

model UsageCounter {
  id          String   @id @default(cuid())
  workspaceId String
  metric      String
  periodStart DateTime
  periodEnd   DateTime
  count       Int      @default(0)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, metric, periodStart])
}

model FeatureFlag {
  id          String   @id @default(cuid())
  workspaceId String?
  key         String
  isEnabled   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, key])
}

// ---------------------------------------------------------------------------
// Files
// ---------------------------------------------------------------------------

model FileAsset {
  id               String               @id @default(cuid())
  projectId        String
  ownerId          String
  kind             FileKind
  originalName     String
  storageKey       String
  url              String
  mimeType         String
  sizeBytes        Int
  processingStatus FileProcessingStatus @default(READY)
  socialPostId     String?

  // --- Media library (Fase 29) — additive -----------------------------------
  /// User-editable display name, independent of originalName ("renombrar" without losing the original filename).
  displayName  String?
  altText      String?
  widthPx      Int?
  heightPx     Int?
  durationSec  Int?
  tags         String[] @default([])
  rightsSource String?
  isArchived   Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project                   Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner                     User                      @relation(fields: [ownerId], references: [id])
  socialPost                SocialPost?               @relation(fields: [socialPostId], references: [id])
  publications              PublicationMedia[]
  aiAgentResources          AiAgentResource[]
  knowledgeSources          KnowledgeSource[]
  performanceMetricEvidence PerformanceMetricRecord[]
  performanceImports        PerformanceImport[]

  @@index([projectId])
  @@index([projectId, isArchived])
}

// ---------------------------------------------------------------------------
// AI Marketing Brain (Fase 30) — the central orchestrator. Deliberately
// creates NO parallel Campaign/Content/Publication model: it only tracks the
// run/step/resource/approval bookkeeping needed to drive Campaign,
// CampaignStrategy, CampaignPillar, CampaignContentPiece, ContentItem, and
// SocialPost creation with idempotent, resumable, reviewable steps. Json is
// used ONLY for the flexible/non-relational pieces the spec explicitly calls
// out: the raw briefing snapshot, the approved-briefing snapshot, per-run
// stage configuration, and small per-step input/output summaries — never as
// a substitute for a queryable relation (those are real FK columns below).
// ---------------------------------------------------------------------------

model MarketingBrainRun {
  id                String                       @id @default(cuid())
  projectId         String
  createdById       String
  campaignId        String?
  status            MarketingBrainRunStatus      @default(DRAFT)
  currentStepKey    MarketingBrainStepKey?
  /// Client-generated once per "Crear plan con IA" click — the (createdById, idempotencyKey) unique index makes a doubled click/request resolve to the same draft instead of creating a second one.
  idempotencyKey    String
  /// Raw wizard input (quick or advanced mode) — never written directly into Campaign/ContentItem/SocialPost without going through the deterministic normalization + AI-schema validation layer first (see src/lib/marketing-brain/normalize.ts).
  briefing          Json
  /// Immutable snapshot taken the moment the user confirms the plan and the run leaves DRAFT/READY — never mutated while RUNNING (spec section 8: "no modificar el briefing aprobado mientras está ejecutándose").
  approvedBriefing  Json?
  /// Which of the 12 stages are enabled, and which stage boundaries require human approval before proceeding — see src/lib/marketing-brain/plan.ts.
  stagesConfig      Json
  progressPercent   Int                          @default(0)
  startedAt         DateTime?
  completedAt       DateTime?
  cancelledAt       DateTime?
  lastErrorMessage  String?
  lastErrorCategory MarketingBrainErrorCategory?
  attemptCount      Int                          @default(0)
  /// Set only when this run was created via "duplicar" — traceability only, never a live dependency (spec section 24: duplication never copies progress/resources/errors).
  sourceRunId       String?
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt

  project              Project                             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy            User                                @relation("MarketingBrainRunCreatedBy", fields: [createdById], references: [id])
  campaign             Campaign?                           @relation("MarketingBrainRunCampaign", fields: [campaignId], references: [id], onDelete: SetNull)
  sourceRun            MarketingBrainRun?                  @relation("MarketingBrainRunDuplicate", fields: [sourceRunId], references: [id], onDelete: SetNull)
  duplicates           MarketingBrainRun[]                 @relation("MarketingBrainRunDuplicate")
  steps                MarketingBrainStep[]
  resources            MarketingBrainResource[]
  approvals            MarketingBrainApproval[]
  optimizationSessions MarketingBrainOptimizationSession[]

  @@unique([createdById, idempotencyKey])
  @@index([projectId, status])
  @@index([projectId, createdById])
  @@index([projectId, createdAt])
  @@index([campaignId])
}

model MarketingBrainStep {
  id               String                       @id @default(cuid())
  runId            String
  key              MarketingBrainStepKey
  status           MarketingBrainStepStatus     @default(PENDING)
  /// Fixed pipeline position (0-11) — mirrors src/lib/marketing-brain/plan.ts's stage order, persisted so a step row is self-describing without re-deriving order from `key`.
  order            Int
  /// Small approved-input summary for this step (e.g. resolved counts/ids used) — never the full generated text; see the model-level note on Json usage.
  input            Json?
  /// Small output summary (counts created/reused/failed, and — for the two "review before committing" AI stages — the parsed structured draft the user reviews). Never a full raw AI transcript.
  output           Json?
  errorMessage     String?
  errorCategory    MarketingBrainErrorCategory?
  attemptCount     Int                          @default(0)
  /// Set for the currently in-flight AI attempt; completeMarketingBrainStepAction/failMarketingBrainStepAction must present this back unchanged — a stale token from a superseded attempt is always rejected, never allowed to overwrite a newer result.
  executionToken   String?
  /// For a multi-item AI step (GENERATE_DRAFTS, ADAPT_PLATFORMS): how many sub-items have been processed / exist in total — lets prepare/complete resume mid-step without reprocessing already-done items.
  currentItemIndex Int?
  totalItems       Int?
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt

  run       MarketingBrainRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  resources MarketingBrainResource[]

  @@unique([runId, key])
  @@index([runId, status])
}

model MarketingBrainResource {
  id                     String                       @id @default(cuid())
  runId                  String
  stepId                 String?
  type                   MarketingBrainResourceType
  action                 MarketingBrainResourceAction
  /// Exactly one of the following is set, matching `type` — real FKs (never a bare polymorphic string id) so every resource this run touched stays genuinely queryable/relatable, per spec section 25.
  campaignId             String?
  campaignPillarId       String?
  campaignContentPieceId String?
  contentItemId          String?
  socialPostId           String?
  createdAt              DateTime                     @default(now())

  run         MarketingBrainRun     @relation(fields: [runId], references: [id], onDelete: Cascade)
  step        MarketingBrainStep?   @relation(fields: [stepId], references: [id], onDelete: SetNull)
  campaign    Campaign?             @relation("MarketingBrainResourceCampaign", fields: [campaignId], references: [id], onDelete: SetNull)
  pillar      CampaignPillar?       @relation(fields: [campaignPillarId], references: [id], onDelete: SetNull)
  piece       CampaignContentPiece? @relation(fields: [campaignContentPieceId], references: [id], onDelete: SetNull)
  contentItem ContentItem?          @relation(fields: [contentItemId], references: [id], onDelete: SetNull)
  socialPost  SocialPost?           @relation(fields: [socialPostId], references: [id], onDelete: SetNull)

  // Postgres treats each NULL as distinct, so these unique constraints only
  // bite on the one populated column per row — exactly the idempotency guard
  // each creation step needs ("no duplicar campaña/ContentItem/SocialPost").
  @@unique([runId, campaignId])
  @@unique([runId, campaignContentPieceId])
  @@unique([runId, contentItemId])
  @@unique([runId, socialPostId])
  @@index([runId])
  @@index([stepId])
  @@index([campaignId])
  @@index([campaignPillarId])
  @@index([campaignContentPieceId])
  @@index([contentItemId])
  @@index([socialPostId])
}

model MarketingBrainApproval {
  id          String                         @id @default(cuid())
  runId       String
  /// Which stage is gated — approval must be APPROVED here before this stage is allowed to execute (spec section 18's 7 gate points all map onto one of the 12 MarketingBrainStepKey values).
  stepKey     MarketingBrainStepKey
  status      MarketingBrainApprovalDecision @default(PENDING)
  decidedById String?
  decidedAt   DateTime?
  comment     String?
  createdAt   DateTime                       @default(now())
  updatedAt   DateTime                       @updatedAt

  run       MarketingBrainRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  decidedBy User?             @relation("MarketingBrainApprovalDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  @@unique([runId, stepKey])
  @@index([runId])
}

/// The "sesión de optimización" (spec section 8/12) — ties a Performance Center context selection to a generated strategy and its human-decided lifecycle. Editing an APPROVED session never mutates it silently: see previousVersionId/nextVersion.
model MarketingBrainOptimizationSession {
  id                  String                           @id @default(cuid())
  projectId           String
  createdById         String
  campaignId          String?
  marketingBrainRunId String?
  /// Set only when an AI Agent run prepared this session as a draft (spec section 18) — traceability only, never authorization to approve.
  createdByAgentRunId String?
  /// Client-generated once per "Analizar rendimiento" click — the (createdById, idempotencyKey) unique index makes a doubled click resolve to the same draft instead of creating a second one.
  idempotencyKey      String
  status              MarketingBrainOptimizationStatus @default(DRAFT)
  contextMode         PerformanceContextMode           @default(NONE)
  /// Validated selection input (period, resourceIds, metricKeys, goalIds, benchmarkIds, experimentIds, recommendationIds, reportIds, compareToPreviousPeriod) — never the resolved data itself, which lives in MarketingBrainContextSnapshot once frozen.
  selection           Json
  /// The parsed, structured strategy brief (executive summary, observed situation, data-backed findings, limitations, objectives, opportunities, risks, hypotheses, recommended strategy, channels, KPIs, success/deterioration signals, measurement plan, review conditions) produced alongside the scenarios — set once generation completes.
  strategyBrief       Json?
  version             Int                              @default(1)
  previousVersionId   String?                          @unique
  decidedById         String?
  decidedAt           DateTime?
  decisionComment     String?
  /// Set for the currently in-flight single-shot AI generation attempt (mirrors MarketingBrainStep.executionToken); a stale token from a superseded attempt is always rejected.
  executionToken      String?
  lockedAt            DateTime?
  lockedBy            String?
  lockExpiresAt       DateTime?
  attemptCount        Int                              @default(0)
  lastErrorMessage    String?
  archivedAt          DateTime?
  createdAt           DateTime                         @default(now())
  updatedAt           DateTime                         @updatedAt

  project           Project                            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy         User                               @relation("MBOptimizationSessionCreatedBy", fields: [createdById], references: [id])
  campaign          Campaign?                          @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  marketingBrainRun MarketingBrainRun?                 @relation(fields: [marketingBrainRunId], references: [id], onDelete: SetNull)
  createdByAgentRun AiAgentRun?                        @relation("MBOptimizationSessionCreatedByAgentRun", fields: [createdByAgentRunId], references: [id], onDelete: SetNull)
  decidedBy         User?                              @relation("MBOptimizationSessionDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  previousVersion   MarketingBrainOptimizationSession? @relation("MBOptimizationSessionVersion", fields: [previousVersionId], references: [id], onDelete: SetNull)
  nextVersion       MarketingBrainOptimizationSession? @relation("MBOptimizationSessionVersion")
  contextSnapshot   MarketingBrainContextSnapshot?
  scenarios         MarketingBrainScenario[]
  measurementPlans  MarketingBrainMeasurementPlan[]

  @@unique([createdById, idempotencyKey])
  @@index([projectId, status])
  @@index([campaignId])
  @@index([marketingBrainRunId])
}

/// Immutable snapshot of the Performance Center context actually used to generate a strategy (spec section 8) — future changes to PerformanceMetricRecord/etc. never rewrite this retrospectively. Separates facts/derived/signals/hypotheses/constraints/missingData so a consumer (human or AI) never confuses an observed fact with an interpretation.
model MarketingBrainContextSnapshot {
  id                    String    @id @default(cuid())
  sessionId             String    @unique
  projectId             String
  periodStart           DateTime
  periodEnd             DateTime
  comparisonPeriodStart DateTime?
  comparisonPeriodEnd   DateTime?
  /// Observed, real data points — never an interpretation.
  facts                 Json
  /// Deterministic calculations (rates, aggregates) derived FROM facts — never an AI opinion.
  derived               Json
  /// Deterministic trend/anomaly/rule signals — never an AI opinion.
  signals               Json
  /// Interpretations not yet proven — must never be presented to the AI (or the user) as a fact.
  hypotheses            Json
  /// Explicit limitations of the data included (small sample, low coverage, stale, etc.).
  constraints           Json
  /// Information that would be needed but does not exist yet.
  missingData           Json
  dataQualityScore      Int
  dataQualityLevel      String
  /// Deterministic evidence-strength classification (spec section 11) — never an AI-produced "confidence score".
  evidenceStrength      String
  metricCount           Int       @default(0)
  resourceCount         Int       @default(0)
  recommendationCount   Int       @default(0)
  experimentCount       Int       @default(0)
  goalCount             Int       @default(0)
  benchmarkCount        Int       @default(0)
  reportCount           Int       @default(0)
  generatedAt           DateTime  @default(now())
  createdAt             DateTime  @default(now())

  session MarketingBrainOptimizationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

/// One of up to three honest strategic scenarios (spec section 10) — never simple copies with different wording; absent data means fewer scenarios, never fabricated ones.
model MarketingBrainScenario {
  id                String                     @id @default(cuid())
  sessionId         String
  projectId         String
  kind              MarketingBrainScenarioKind
  objective         String
  intensity         String
  timeframe         String
  measurementMethod String
  risks             String[]                   @default([])
  kpis              String[]                   @default([])
  preconditions     String[]                   @default([])
  constraints       String[]                   @default([])
  resourcesRequired String[]                   @default([])
  /// Which scenario the human chose to move forward with — at most one per session in practice, enforced at the service layer (never two "selected" scenarios driving conversion at once).
  selected          Boolean                    @default(false)
  createdAt         DateTime                   @default(now())

  session MarketingBrainOptimizationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  actions MarketingBrainScenarioAction[]

  @@unique([sessionId, kind])
  @@index([projectId])
}

/// A single proposed action within a scenario — the user selects which ones to convert into real resources (spec section 13); never all-at-once. Idempotent: convertedAt/convertedById are claimed atomically once, and the populated FK is the single source of truth for "already converted".
model MarketingBrainScenarioAction {
  id                     String                           @id @default(cuid())
  scenarioId             String
  projectId              String
  order                  Int
  title                  String
  description            String                           @db.Text
  channel                String?
  actionType             MarketingBrainScenarioActionType
  convertedById          String?
  convertedAt            DateTime?
  campaignContentPieceId String?
  contentItemId          String?
  socialPostId           String?
  agentRunId             String?
  knowledgeQueryId       String?
  createdAt              DateTime                         @default(now())

  scenario             MarketingBrainScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  convertedBy          User?                  @relation("MBScenarioActionConvertedBy", fields: [convertedById], references: [id], onDelete: SetNull)
  campaignContentPiece CampaignContentPiece?  @relation(fields: [campaignContentPieceId], references: [id], onDelete: SetNull)
  contentItem          ContentItem?           @relation(fields: [contentItemId], references: [id], onDelete: SetNull)
  socialPost           SocialPost?            @relation(fields: [socialPostId], references: [id], onDelete: SetNull)
  agentRun             AiAgentRun?            @relation("MBScenarioActionAgentRun", fields: [agentRunId], references: [id], onDelete: SetNull)
  knowledgeQuery       KnowledgeQuery?        @relation(fields: [knowledgeQueryId], references: [id], onDelete: SetNull)

  @@index([scenarioId])
  @@index([projectId])
}

/// Defines what to track after a strategy/scenario is approved (spec section 14) — the baseline is captured once from real data and never recalculated retrospectively.
model MarketingBrainMeasurementPlan {
  id                    String                          @id @default(cuid())
  sessionId             String
  projectId             String
  createdById           String
  primaryMetricKey      String
  secondaryMetricKeys   String[]                        @default([])
  resourceType          PerformanceResourceType
  contentItemId         String?
  campaignId            String?
  socialPostId          String?
  goalId                String?
  trackingStart         DateTime
  trackingEnd           DateTime
  comparisonPeriodStart DateTime?
  comparisonPeriodEnd   DateTime?
  baselineValue         Decimal?                        @db.Decimal(18, 4)
  baselineQuality       String?
  baselineSampleSize    Int?
  baselineCapturedAt    DateTime?
  status                MarketingBrainMeasurementStatus @default(ACTIVE)
  createdAt             DateTime                        @default(now())
  updatedAt             DateTime                        @updatedAt

  session     MarketingBrainOptimizationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  createdBy   User                              @relation("MBMeasurementPlanCreatedBy", fields: [createdById], references: [id])
  contentItem ContentItem?                      @relation(fields: [contentItemId], references: [id], onDelete: SetNull)
  campaign    Campaign?                         @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  socialPost  SocialPost?                       @relation(fields: [socialPostId], references: [id], onDelete: SetNull)
  goal        PerformanceGoal?                  @relation(fields: [goalId], references: [id], onDelete: SetNull)
  reviews     MarketingBrainMeasurementReview[]

  @@index([sessionId])
  @@index([projectId, status])
}

/// A single post-hoc review generated against a measurement plan (spec section 14) — a plan can accumulate several over time (repeated check-ins). Never marks REACHED/NOT_REACHED without enough data; never asserts causality without a linked, valid experiment.
model MarketingBrainMeasurementReview {
  id                 String                           @id @default(cuid())
  planId             String
  projectId          String
  createdById        String
  /// Stable per calendar day — regenerating a review the same day updates in place rather than duplicating (spec section 46-style idempotency).
  idempotencyKey     String                           @unique
  initialValue       Decimal?                         @db.Decimal(18, 4)
  currentValue       Decimal?                         @db.Decimal(18, 4)
  absoluteDiff       Decimal?                         @db.Decimal(18, 4)
  percentDiff        Decimal?                         @db.Decimal(18, 4)
  initialQuality     String?
  currentQuality     String?
  goalOutcome        MarketingBrainGoalOutcome        @default(INDETERMINATE)
  relatedAnomalies   Json                             @default("[]")
  relatedExperiments Json                             @default("[]")
  limitations        String[]                         @default([])
  conclusion         String                           @db.Text
  causalityStatement MarketingBrainCausalityStatement @default(CANNOT_CONFIRM)
  generatedAt        DateTime                         @default(now())
  createdAt          DateTime                         @default(now())

  plan      MarketingBrainMeasurementPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  createdBy User                          @relation("MBMeasurementReviewCreatedBy", fields: [createdById], references: [id])

  @@index([planId])
  @@index([projectId])
}

// ---------------------------------------------------------------------------
// AI Agent Studio (Fase 31) — official agents are defined in code
// (src/lib/agents/registry.ts) and referenced by a stable string key
// (AiAgentRun.officialAgentKey); only CUSTOM agents get a real row here.
// No parallel content/campaign/publication model is created — every
// produced resource is one of the existing models, tracked via
// AiAgentResource the same way Marketing Brain tracks its own (Fase 30).
// ---------------------------------------------------------------------------

model AiAgent {
  id                 String            @id @default(cuid())
  projectId          String
  createdById        String
  name               String
  description        String            @db.Text
  /// Lucide icon name (e.g. "PenLine") — custom agents can't import a component reference, so this is resolved through a small name->component lookup in the UI, same spirit as the official registry storing real components.
  icon               String
  category           AiAgentCategory
  objective          String?           @db.Text
  systemInstructions String            @db.Text
  /// AgentInputFieldSpec[] — see src/lib/agents/types.ts. Drives the dynamic form builder; never duplicated per-agent in a component.
  inputSchema        Json
  outputType         AiAgentOutputType
  brandProfileId     String?
  language           String            @default("es")
  creativity         AiAgentCreativity @default(BALANCED)
  /// Closed vocabulary of context/capability toggles (e.g. "brand-profile", "content-search", "seo-scoring") — never arbitrary code execution or external tool names.
  allowedTools       String[]          @default([])
  /// Official key or custom AiAgent.id this agent's output is reviewed by, if any.
  reviewerAgentRef   String?
  requireApproval    Boolean           @default(false)
  maxSteps           Int               @default(1)
  visibility         AiAgentVisibility @default(PROJECT)
  status             AiAgentStatus     @default(ACTIVE)
  isTemplate         Boolean           @default(false)
  templateSourceId   String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  project           Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy         User          @relation("AiAgentCreatedBy", fields: [createdById], references: [id])
  brandProfile      BrandProfile? @relation(fields: [brandProfileId], references: [id], onDelete: SetNull)
  templateSource    AiAgent?      @relation("AiAgentTemplateSource", fields: [templateSourceId], references: [id], onDelete: SetNull)
  templateInstances AiAgent[]     @relation("AiAgentTemplateSource")
  runs              AiAgentRun[]

  @@index([projectId, status])
  @@index([projectId, category])
}

model AiAgentTeam {
  id                  String                   @id @default(cuid())
  projectId           String
  createdById         String
  name                String
  description         String?                  @db.Text
  objective           String?                  @db.Text
  /// Official key or custom AiAgent.id — interprets the task, prepares context, watches progress (spec section 12). Never invents agents/tools at runtime; only picks from this team's own saved member list.
  coordinatorAgentRef String
  reviewerAgentRef    String?
  errorStrategy       AiAgentTeamErrorStrategy @default(STOP_ON_ERROR)
  status              AiAgentStatus            @default(ACTIVE)
  isTemplate          Boolean                  @default(false)
  templateSourceId    String?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  project           Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy         User                @relation("AiAgentTeamCreatedBy", fields: [createdById], references: [id])
  templateSource    AiAgentTeam?        @relation("AiAgentTeamTemplateSource", fields: [templateSourceId], references: [id], onDelete: SetNull)
  templateInstances AiAgentTeam[]       @relation("AiAgentTeamTemplateSource")
  members           AiAgentTeamMember[]
  runs              AiAgentRun[]

  @@index([projectId, status])
}

model AiAgentTeamMember {
  id              String   @id @default(cuid())
  teamId          String
  /// Official key or custom AiAgent.id.
  agentRef        String
  /// Sequential position — teams in this phase are linear pipelines (matches every official example: Content Production, Social Campaign, SEO Article).
  order           Int
  enabled         Boolean  @default(true)
  requireApproval Boolean  @default(false)
  createdAt       DateTime @default(now())

  team AiAgentTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, order])
  @@index([teamId])
}

model AiAgentRun {
  id                String                @id @default(cuid())
  projectId         String
  createdById       String
  /// Exactly one of officialAgentKey/customAgentId/teamId is set (app-enforced) — a run always targets ONE agent, ONE custom agent, or ONE team.
  officialAgentKey  String?
  customAgentId     String?
  teamId            String?
  status            AiAgentRunStatus      @default(DRAFT)
  currentStepOrder  Int?
  /// Client-generated once per "Ejecutar" click — the (createdById, idempotencyKey) unique index makes a doubled click/request resolve to the same run instead of creating a second one.
  idempotencyKey    String
  /// Raw draft input before approval.
  input             Json
  /// Immutable snapshot taken when the run leaves DRAFT — never mutated while RUNNING (spec section 9: "no modificar entradas aprobadas durante la ejecución").
  approvedInput     Json?
  /// Team-run-only: which members are enabled + per-member approval overrides, snapshotted at start.
  stagesConfig      Json?
  progressPercent   Int                   @default(0)
  brandProfileId    String?
  /// Final structured result summary — never a full duplicate of the underlying ContentItem/Campaign/SocialPost row (those stay the single source of truth, referenced via AiAgentResource).
  result            Json?
  lastErrorMessage  String?
  lastErrorCategory AiAgentErrorCategory?
  attemptCount      Int                   @default(0)
  /// Set only when this run was created via "duplicar" — traceability only.
  sourceRunId       String?
  startedAt         DateTime?
  completedAt       DateTime?
  cancelledAt       DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  project                              Project                             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy                            User                                @relation("AiAgentRunCreatedBy", fields: [createdById], references: [id])
  customAgent                          AiAgent?                            @relation(fields: [customAgentId], references: [id], onDelete: SetNull)
  team                                 AiAgentTeam?                        @relation(fields: [teamId], references: [id], onDelete: SetNull)
  brandProfile                         BrandProfile?                       @relation(fields: [brandProfileId], references: [id], onDelete: SetNull)
  sourceRun                            AiAgentRun?                         @relation("AiAgentRunDuplicate", fields: [sourceRunId], references: [id], onDelete: SetNull)
  duplicates                           AiAgentRun[]                        @relation("AiAgentRunDuplicate")
  steps                                AiAgentRunStep[]
  approvals                            AiAgentApproval[]
  resources                            AiAgentResource[]
  memories                             AiAgentMemory[]
  performanceExperimentVariantsCreated PerformanceExperimentVariant[]      @relation("PerformanceExperimentVariantCreatedByAgentRun")
  performanceRecommendationActions     PerformanceRecommendationAction[]   @relation("PerformanceRecommendationActionAgentRun")
  mbOptimizationSessionsCreated        MarketingBrainOptimizationSession[] @relation("MBOptimizationSessionCreatedByAgentRun")
  mbScenarioActionsCreated             MarketingBrainScenarioAction[]      @relation("MBScenarioActionAgentRun")
  governanceSnapshot                   AiAgentRunGovernanceSnapshot?
  governanceApproval                   AiAgentGovernanceApproval?
  customerSupportMessages              CustomerSupportMessage[]

  @@unique([createdById, idempotencyKey])
  @@index([projectId, status])
  @@index([projectId, createdById])
  @@index([projectId, createdAt])
  @@index([customAgentId])
  @@index([teamId])
}

model AiAgentRunStep {
  id               String                @id @default(cuid())
  runId            String
  order            Int
  /// Official key or custom AiAgent.id responsible for this step.
  agentRef         String
  status           AiAgentRunStepStatus  @default(PENDING)
  /// Small approved-input summary for this step — never the full generated text; see model-level note on Json usage.
  input            Json?
  /// Small structured output (validated/repaired) — see src/lib/agents/structured-output.ts.
  output           Json?
  errorMessage     String?
  errorCategory    AiAgentErrorCategory?
  attemptCount     Int                   @default(0)
  /// Set for the currently in-flight AI attempt; complete/fail actions must present this back unchanged — a stale token from a superseded attempt is always rejected.
  executionToken   String?
  /// For a multi-item step (e.g. generating N social variants): how many sub-items have been processed / exist in total.
  currentItemIndex Int?
  totalItems       Int?
  requiresApproval Boolean               @default(false)
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  run       AiAgentRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  resources AiAgentResource[]

  @@unique([runId, order])
  @@index([runId, status])
}

model AiAgentApproval {
  id            String                  @id @default(cuid())
  runId         String
  stepOrder     Int
  status        AiAgentApprovalDecision @default(PENDING)
  decidedById   String?
  decidedAt     DateTime?
  comment       String?                 @db.Text
  /// Set when the user edited the output as part of deciding — kept distinct from the step's raw AI output for honest diagnostics (spec section 13: "versión revisada").
  revisedOutput Json?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  run       AiAgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  decidedBy User?      @relation("AiAgentApprovalDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  @@unique([runId, stepOrder])
  @@index([runId])
}

/// A versioned, project-scoped governance policy — never edited in place. Activating a new version archives the previous one; exactly one ACTIVE row per project is enforced by a partial unique index added directly in the migration SQL (Prisma's schema DSL can't express a WHERE-scoped unique index).
model AiAgentPolicy {
  id                           String                      @id @default(cuid())
  projectId                    String
  version                      Int
  status                       AiAgentPolicyStatus         @default(DRAFT)
  createdById                  String
  comment                      String?                     @db.Text
  maxRiskLevel                 GovernanceRiskLevel         @default(DRAFT_WRITE)
  requireApprovalAtOrAboveRisk GovernanceRiskLevel?
  maxRunsPerDay                Int?
  maxRunsPerMonth              Int?
  maxConcurrentRunsPerProject  Int                         @default(5)
  maxConcurrentRunsPerAgent    Int                         @default(2)
  maxRetries                   Int                         @default(3)
  maxDurationSeconds           Int?
  maxSteps                     Int?
  maxContextChars              Int?
  maxOutputChars               Int?
  onBudgetExhausted            AiAgentBudgetOnExhausted    @default(DENY)
  /// Deny-list of officialAgentKey/customAgentId values — an empty array means every discoverable agent stays allowed by default (spec section 8: safe defaults, never silently blocking everything).
  disabledAgentRefs            String[]                    @default([])
  /// Fase 38 spec sections 13-14: behavior when an operation targets an agent/mode with NO matching AiAgentPolicyRule at all.
  unknownAgentBehavior         AiAgentUnknownAgentBehavior @default(ALLOW_DEFAULT)
  /// Fase 38 spec section 22: set when this DRAFT was created as a "restore" of an earlier version — traceability only, never used by the engine, never mutates the source version.
  basedOnPolicyId              String?
  activatedAt                  DateTime?
  archivedAt                   DateTime?
  createdAt                    DateTime                    @default(now())
  updatedAt                    DateTime                    @updatedAt

  project         Project                        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy       User                           @relation("AiAgentPolicyCreatedBy", fields: [createdById], references: [id])
  basedOnPolicy   AiAgentPolicy?                 @relation("AiAgentPolicyRestoredFrom", fields: [basedOnPolicyId], references: [id], onDelete: SetNull)
  restoredInto    AiAgentPolicy[]                @relation("AiAgentPolicyRestoredFrom")
  rules           AiAgentPolicyRule[]
  approvals       AiAgentGovernanceApproval[]
  runSnapshots    AiAgentRunGovernanceSnapshot[]
  rollout         AiAgentPolicyRollout?
  changeApprovals AiAgentPolicyChangeApproval[]

  @@unique([projectId, version])
  @@index([projectId, status])
}

/// Agent/mode overrides layered on top of a policy's base fields — MODE-scope rows always win over AGENT-scope rows for the same agentRef (spec section 9). `mode` uses "" (never null) for AGENT-scope rows so the unique constraint genuinely blocks duplicates (Postgres treats every NULL as distinct).
model AiAgentPolicyRule {
  id              String                 @id @default(cuid())
  policyId        String
  scope           AiAgentPolicyRuleScope
  agentRef        String
  mode            String                 @default("")
  enabled         Boolean?
  riskOverride    GovernanceRiskLevel?
  requireApproval Boolean?
  maxRunsPerDay   Int?
  maxConcurrent   Int?
  maxRetries      Int?
  /// Fase 38 spec section 25: optional validity window — a rule outside this window is treated by the resolver as NOT matched (never deleted, always kept for history). Never enforced only by a cron; the resolver re-checks the window on every real evaluation.
  startsAt        DateTime?
  expiresAt       DateTime?
  createdAt       DateTime               @default(now())

  policy AiAgentPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@unique([policyId, scope, agentRef, mode])
  @@index([policyId])
}

/// Fase 38 spec section 19: staged rollout tracking for a single DRAFT policy version — one row per policy (never a second parallel "active" concept; promotion to PROMOTED happens exactly when the real activatePolicyVersion() flips AiAgentPolicy.status to ACTIVE).
model AiAgentPolicyRollout {
  id                    String              @id @default(cuid())
  policyId              String              @unique
  projectId             String
  stage                 AiAgentRolloutStage @default(SHADOW)
  /// LIMITED scope — empty arrays mean "no restriction on that dimension". Percentage uses deterministic hashing (spec section 19: "misma entrada produce la misma asignación"), never per-request randomness.
  scopeAgentRefs        String[]            @default([])
  scopeModes            String[]            @default([])
  percentage            Int?
  createdById           String
  createdAt             DateTime            @default(now())
  stageChangedAt        DateTime            @default(now())
  /// Cheap running counters for promotion review (spec section 21) — detailed rows are kept only for evaluations that actually differ (AiAgentPolicyShadowEvaluation), never one row per evaluation.
  shadowEvaluationCount Int                 @default(0)
  shadowDifferenceCount Int                 @default(0)
  promotedById          String?
  promotedAt            DateTime?
  retiredById           String?
  retiredAt             DateTime?

  policy      AiAgentPolicy                   @relation(fields: [policyId], references: [id], onDelete: Cascade)
  project     Project                         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy   User                            @relation("AiAgentPolicyRolloutCreatedBy", fields: [createdById], references: [id])
  promotedBy  User?                           @relation("AiAgentPolicyRolloutPromotedBy", fields: [promotedById], references: [id], onDelete: SetNull)
  retiredBy   User?                           @relation("AiAgentPolicyRolloutRetiredBy", fields: [retiredById], references: [id], onDelete: SetNull)
  evaluations AiAgentPolicyShadowEvaluation[]

  @@index([projectId, stage])
}

/// Fase 38 spec section 20: a bounded record of a SHADOW/LIMITED evaluation whose hypothetical decision DIFFERED from the real active decision — never a full duplicate snapshot, never affects the real run.
model AiAgentPolicyShadowEvaluation {
  id             String             @id @default(cuid())
  rolloutId      String
  projectId      String
  agentRef       String
  mode           String?
  activeDecision GovernanceDecision
  shadowDecision GovernanceDecision
  activeCode     String
  shadowCode     String
  runId          String?
  createdAt      DateTime           @default(now())

  rollout AiAgentPolicyRollout @relation(fields: [rolloutId], references: [id], onDelete: Cascade)
  project Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([rolloutId, createdAt])
}

/// Fase 38 spec sections 23-24: human approval for a SENSITIVE policy activation — distinct from AiAgentGovernanceApproval (gates a run) and AiAgentApproval (gates a step). Real separation-of-duties when the project has more than one MANAGER/OWNER; a documented, audited, reinforced-confirmation fallback otherwise (see governance-sensitive-changes.ts).
model AiAgentPolicyChangeApproval {
  id               String                            @id @default(cuid())
  projectId        String
  policyId         String
  requestedById    String
  /// Ordered {code, label}[] — exactly which sensitive changes triggered this requirement, computed deterministically, never AI-classified.
  sensitiveChanges Json
  reason           String                            @db.Text
  status           AiAgentPolicyChangeApprovalStatus @default(PENDING)
  decidedById      String?
  decidedAt        DateTime?
  decisionComment  String?
  idempotencyKey   String                            @unique
  createdAt        DateTime                          @default(now())
  updatedAt        DateTime                          @updatedAt

  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  policy      AiAgentPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  requestedBy User          @relation("AiAgentPolicyChangeApprovalRequestedBy", fields: [requestedById], references: [id])
  decidedBy   User?         @relation("AiAgentPolicyChangeApprovalDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([projectId, status])
}

/// Pause/emergency controls — deliberately NOT versioned like AiAgentPolicy (spec section 16 frames these as fast, operational toggles, distinct from deliberate policy editing); every toggle is still audited via the shared AuditLog + a real Automation Center event. One row per project.
model AiAgentProjectGovernanceState {
  id                       String    @id @default(cuid())
  projectId                String    @unique
  projectPaused            Boolean   @default(false)
  projectPausedAt          DateTime?
  projectPausedById        String?
  emergencyStopEnabled     Boolean   @default(false)
  emergencyStopEnabledAt   DateTime?
  emergencyStopEnabledById String?
  /// officialAgentKey/customAgentId values individually paused — independent of disabledAgentRefs on the policy (this is the fast operational toggle, not a policy edit).
  pausedAgentRefs          String[]  @default([])
  updatedAt                DateTime  @updatedAt
  createdAt                DateTime  @default(now())

  project            Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pausedBy           User?   @relation("AiAgentGovernanceProjectPausedBy", fields: [projectPausedById], references: [id], onDelete: SetNull)
  emergencyStoppedBy User?   @relation("AiAgentGovernanceEmergencyStoppedBy", fields: [emergencyStopEnabledById], references: [id], onDelete: SetNull)
}

/// Reserved vs consumed counters per project/scope/metric/window/period — atomic claims via updateMany, never a plain count-then-create (spec section 15). `agentRef` uses "" (never null) for PROJECT-scope rows for the same NULL-distinctness reason as AiAgentPolicyRule.mode.
model AiAgentBudgetUsage {
  id          String              @id @default(cuid())
  projectId   String
  scope       AiAgentBudgetScope
  agentRef    String              @default("")
  metric      AiAgentBudgetMetric
  window      AiAgentBudgetWindow
  periodStart DateTime
  periodEnd   DateTime
  reserved    Int                 @default(0)
  consumed    Int                 @default(0)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, scope, agentRef, metric, window, periodStart])
  @@index([projectId, window, periodStart])
}

/// A real, human-only pre-run approval request (spec section 12) — distinct from AiAgentApproval above, which gates a STEP inside an already-started run; this gates whether the RUN is even created/started at all. Never decided by AI/cron/automation/workflow — see decideGovernanceApproval in src/server/services/agent-governance-approvals.ts.
model AiAgentGovernanceApproval {
  id              String                          @id @default(cuid())
  projectId       String
  requestedById   String
  agentRef        String
  mode            String?
  riskLevel       GovernanceRiskLevel
  /// Bounded, sanitized copy of the values that will seed the run once approved — never a full untrusted client payload (spec section 36).
  sanitizedInput  Json
  reason          String                          @db.Text
  policyId        String
  policyVersion   Int
  status          AiAgentGovernanceApprovalStatus @default(PENDING)
  decidedById     String?
  decidedAt       DateTime?
  decisionComment String?
  expiresAt       DateTime?
  /// Set once a real AiAgentRun is actually created from this approval — the idempotency guard against double-creation.
  createdRunId    String?                         @unique
  idempotencyKey  String                          @unique
  createdAt       DateTime                        @default(now())
  updatedAt       DateTime                        @updatedAt

  project      Project                        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requestedBy  User                           @relation("AiAgentGovernanceApprovalRequestedBy", fields: [requestedById], references: [id])
  decidedBy    User?                          @relation("AiAgentGovernanceApprovalDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  policy       AiAgentPolicy                  @relation(fields: [policyId], references: [id])
  createdRun   AiAgentRun?                    @relation(fields: [createdRunId], references: [id], onDelete: SetNull)
  runSnapshots AiAgentRunGovernanceSnapshot[]

  @@index([projectId, status])
}

/// The immutable governance decision a run was actually created/started under (spec section 17) — 1:1 with AiAgentRun, never recalculated retrospectively. Changing a policy afterward never rewrites this row.
model AiAgentRunGovernanceSnapshot {
  id                  String              @id @default(cuid())
  runId               String              @unique
  projectId           String
  decision            GovernanceDecision
  code                String
  reason              String              @db.Text
  policyId            String?
  policyVersion       Int?
  riskLevel           GovernanceRiskLevel
  /// Ordered {code, outcome, message}[] — the full explainable trail (spec section 5: "debe ser posible explicar por qué").
  rulesEvaluated      Json
  effectiveLimits     Json
  budgetSnapshot      Json
  concurrencyObserved Int
  approvalId          String?
  evaluatedAt         DateTime            @default(now())

  run      AiAgentRun                 @relation(fields: [runId], references: [id], onDelete: Cascade)
  project  Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  policy   AiAgentPolicy?             @relation(fields: [policyId], references: [id], onDelete: SetNull)
  approval AiAgentGovernanceApproval? @relation(fields: [approvalId], references: [id], onDelete: SetNull)

  @@index([projectId, decision])
}

model AiAgentMemory {
  id           String            @id @default(cuid())
  projectId    String
  /// Official key or custom AiAgent.id this memory belongs to — memory never mixes across agents or projects.
  agentRef     String
  type         AiAgentMemoryType
  content      String            @db.Text
  /// Which run this memory was proposed from, if any — "mostrar origen" (spec section 15).
  sourceRunId  String?
  /// Always set — memory is never auto-saved; the save action IS the user's approval.
  approvedById String
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceRun  AiAgentRun? @relation(fields: [sourceRunId], references: [id], onDelete: SetNull)
  approvedBy User        @relation("AiAgentMemoryApprovedBy", fields: [approvedById], references: [id])

  @@index([projectId, agentRef])
  @@index([sourceRunId])
}

model AiAgentResource {
  id                     String                @id @default(cuid())
  runId                  String
  stepId                 String?
  type                   AiAgentResourceType
  action                 AiAgentResourceAction
  /// Exactly one of the following is set, matching `type` — real FKs (never a bare polymorphic string id), same pattern as MarketingBrainResource.
  contentItemId          String?
  campaignId             String?
  campaignStrategyId     String?
  campaignPillarId       String?
  campaignContentPieceId String?
  socialPostId           String?
  fileAssetId            String?
  createdAt              DateTime              @default(now())

  run              AiAgentRun            @relation(fields: [runId], references: [id], onDelete: Cascade)
  step             AiAgentRunStep?       @relation(fields: [stepId], references: [id], onDelete: SetNull)
  contentItem      ContentItem?          @relation(fields: [contentItemId], references: [id], onDelete: SetNull)
  campaign         Campaign?             @relation("AiAgentResourceCampaign", fields: [campaignId], references: [id], onDelete: SetNull)
  campaignStrategy CampaignStrategy?     @relation(fields: [campaignStrategyId], references: [id], onDelete: SetNull)
  pillar           CampaignPillar?       @relation(fields: [campaignPillarId], references: [id], onDelete: SetNull)
  piece            CampaignContentPiece? @relation(fields: [campaignContentPieceId], references: [id], onDelete: SetNull)
  socialPost       SocialPost?           @relation(fields: [socialPostId], references: [id], onDelete: SetNull)
  fileAsset        FileAsset?            @relation(fields: [fileAssetId], references: [id], onDelete: SetNull)

  // Postgres treats each NULL as distinct, so these unique constraints only
  // bite on the one populated column per row — the idempotency guard each
  // creation step needs ("no duplicar ContentItem/Campaign/SocialPost").
  @@unique([runId, contentItemId])
  @@unique([runId, campaignId])
  @@unique([runId, socialPostId])
  @@index([runId])
  @@index([stepId])
  @@index([contentItemId])
  @@index([campaignId])
  @@index([campaignPillarId])
  @@index([campaignContentPieceId])
  @@index([socialPostId])
  @@index([fileAssetId])
}

// ---------------------------------------------------------------------------
// AI Knowledge Base & Document Intelligence (Fase 32) — per-project sources
// (uploaded files, pasted text, or a snapshot of an internal resource),
// organized into collections, split into deterministic chunks, indexed with
// Postgres full-text search (no extension required — see KnowledgeChunk's
// generated tsvector column, added by hand in the migration SQL since
// Prisma's own "Unsupported" columns are DB-managed), and queried through a
// controlled RAG flow that always cites real chunks. Deliberately creates NO
// parallel file-storage/content model: FileAsset stays the single physical
// file representation (see KnowledgeSource.fileAssetId), and
// ContentItem/Campaign/CampaignStrategy/CampaignContentPiece/SocialPost/
// SavedPrompt stay the single source of truth for internal-resource content
// — a KnowledgeSource from one of those is just a versioned, indexable
// snapshot, never a fork.
// ---------------------------------------------------------------------------

enum KnowledgeCollectionStatus {
  ACTIVE
  ARCHIVED
}

enum KnowledgeSourceOriginType {
  PASTED_TEXT
  FILE
  CONTENT_ITEM
  CAMPAIGN
  CAMPAIGN_STRATEGY
  CAMPAIGN_CONTENT_PIECE
  SOCIAL_POST
  SAVED_PROMPT
  NOTE
}

/// Formats this phase actually extracts real text from (spec section 3: "no afirmes compatibilidad con formatos que no se procesen realmente").
enum KnowledgeSourceFormat {
  TEXT
  MARKDOWN
  CSV
  JSON
  PDF
  DOCX
  HTML
}

enum KnowledgeSourceStatus {
  DRAFT
  QUEUED
  EXTRACTING
  NORMALIZING
  CHUNKING
  INDEXING
  READY
  PARTIALLY_READY
  FAILED
  NEEDS_OCR
  ARCHIVED
}

enum KnowledgeSourceSyncMode {
  MANUAL
  ON_SAVE
  DISABLED
}

enum KnowledgeExtractionQuality {
  HIGH
  MEDIUM
  LOW
  NONE
}

enum KnowledgeChunkStatus {
  PENDING
  READY
  FAILED
  ARCHIVED
}

/// Small, independently retryable persistent processing stages (spec section 30) — never one long-lived HTTP request.
enum KnowledgeProcessingStage {
  REGISTER
  EXTRACT
  NORMALIZE
  CHUNK
  INDEX
  FINALIZE
}

enum KnowledgeProcessingAttemptStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

/// Persisted error categorization (distinct from the richer functional error-code union in src/lib/knowledge/types.ts, which is UI-facing and not worth a DB enum per value).
enum KnowledgeErrorCategory {
  VALIDATION
  PERMISSION
  EXTRACTION
  NORMALIZATION
  CHUNKING
  INDEXING
  SEARCH
  CONFLICT
  AI
  INTERNAL_SAFE
}

enum KnowledgeQueryMode {
  SOURCES_ONLY
  SOURCES_PLUS_GENERAL
}

enum KnowledgeQueryStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum KnowledgeCitationType {
  DIRECT
  CONTEXTUAL
}

model KnowledgeCollection {
  id          String                    @id @default(cuid())
  projectId   String
  createdById String
  name        String
  description String?                   @db.Text
  /// Lucide icon name, resolved through the same small name->component lookup as AiAgent.icon.
  icon        String                    @default("Folder")
  color       String                    @default("#6366f1")
  status      KnowledgeCollectionStatus @default(ACTIVE)
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt

  project   Project                     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User                        @relation("KnowledgeCollectionCreatedBy", fields: [createdById], references: [id])
  sources   KnowledgeCollectionSource[]

  @@index([projectId, status])
}

model KnowledgeCollectionSource {
  id           String   @id @default(cuid())
  collectionId String
  sourceId     String
  addedById    String
  addedAt      DateTime @default(now())

  collection KnowledgeCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  source     KnowledgeSource     @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  addedBy    User                @relation("KnowledgeCollectionSourceAddedBy", fields: [addedById], references: [id])

  @@unique([collectionId, sourceId])
  @@index([sourceId])
}

model KnowledgeSource {
  id                     String                    @id @default(cuid())
  projectId              String
  createdById            String
  title                  String
  description            String?                   @db.Text
  originType             KnowledgeSourceOriginType
  format                 KnowledgeSourceFormat
  /// Set only when originType = FILE — the physical file always stays FileAsset's, never copied (spec section 4).
  fileAssetId            String?
  /// Set only when originType references that internal resource — exactly one of these six is non-null (app-enforced), matching the AiAgentResource precedent.
  contentItemId          String?
  campaignId             String?
  campaignStrategyId     String?
  campaignContentPieceId String?
  socialPostId           String?
  savedPromptId          String?
  /// Set only when this source is a Performance Center report snapshot (spec section 35) — created via the same PASTED_TEXT path as any other pasted source, never a new origin type; this FK exists purely for traceability back to the report that generated it.
  performanceReportId    String?
  status                 KnowledgeSourceStatus     @default(DRAFT)
  syncMode               KnowledgeSourceSyncMode   @default(MANUAL)
  /// The version currently used for search/citations — versions before it are kept for history/comparison, never deleted on their own.
  activeVersionId        String?                   @unique
  language               String?
  lastErrorMessage       String?
  lastErrorCategory      KnowledgeErrorCategory?
  /// Set when a sensitive-looking pattern (API key, token, password, connection string) was detected in the extracted text — informational only, never auto-redacted (spec section 33: "no elimines contenido automáticamente por una detección").
  sensitiveWarning       Boolean                   @default(false)
  isArchived             Boolean                   @default(false)
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt

  project              Project                     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy            User                        @relation("KnowledgeSourceCreatedBy", fields: [createdById], references: [id])
  /// Restrict, not Cascade/SetNull — deleting a still-referenced FileAsset must fail at the DB level too (belt-and-suspenders alongside the app-level check in deleteMediaAction), never silently orphan a source (spec section 34).
  fileAsset            FileAsset?                  @relation(fields: [fileAssetId], references: [id], onDelete: Restrict)
  contentItem          ContentItem?                @relation(fields: [contentItemId], references: [id], onDelete: SetNull)
  campaign             Campaign?                   @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  campaignStrategy     CampaignStrategy?           @relation(fields: [campaignStrategyId], references: [id], onDelete: SetNull)
  campaignContentPiece CampaignContentPiece?       @relation(fields: [campaignContentPieceId], references: [id], onDelete: SetNull)
  socialPost           SocialPost?                 @relation(fields: [socialPostId], references: [id], onDelete: SetNull)
  savedPrompt          SavedPrompt?                @relation(fields: [savedPromptId], references: [id], onDelete: SetNull)
  performanceReport    PerformanceReport?          @relation(fields: [performanceReportId], references: [id], onDelete: SetNull)
  activeVersion        KnowledgeSourceVersion?     @relation("KnowledgeSourceActiveVersion", fields: [activeVersionId], references: [id], onDelete: SetNull)
  versions             KnowledgeSourceVersion[]    @relation("KnowledgeSourceVersions")
  collections          KnowledgeCollectionSource[]
  citations            KnowledgeCitation[]
  contentCitations     ContentKnowledgeCitation[]

  @@index([projectId, status])
  @@index([projectId, isArchived])
  @@index([fileAssetId])
  @@index([contentItemId])
  @@index([campaignId])
  @@index([campaignStrategyId])
  @@index([campaignContentPieceId])
  @@index([socialPostId])
  @@index([savedPromptId])
  @@index([performanceReportId])
}

model KnowledgeSourceVersion {
  id                 String                      @id @default(cuid())
  sourceId           String
  /// Sequential per source, starting at 1 — see checksum-based duplicate/new-version detection in src/lib/knowledge/checksum.ts.
  version            Int
  /// Per-version processing state — independent of KnowledgeSource.status only while multiple versions can theoretically coexist mid-processing; in practice the source's own status always mirrors its active/latest version.
  status             KnowledgeSourceStatus       @default(QUEUED)
  title              String?
  author             String?
  detectedLanguage   String?
  rawText            String?                     @db.Text
  normalizedText     String?                     @db.Text
  checksumRaw        String
  checksumNormalized String?
  extractionMethod   String?
  extractionQuality  KnowledgeExtractionQuality?
  warnings           String[]                    @default([])
  pageCount          Int?
  sectionCount       Int?
  charCount          Int                         @default(0)
  /// Safe metadata only (mimeType, sizeBytes, csv column count, json path count...) — never secrets (spec section 7).
  metadata           Json?
  /// Guards the currently in-flight processing stage — a stage-complete call must present this back unchanged (same convention as AiAgentRunStep.executionToken).
  executionToken     String?
  currentStage       KnowledgeProcessingStage?
  attemptCount       Int                         @default(0)
  lastErrorMessage   String?
  lastErrorCategory  KnowledgeErrorCategory?
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt

  source    KnowledgeSource              @relation("KnowledgeSourceVersions", fields: [sourceId], references: [id], onDelete: Cascade)
  activeFor KnowledgeSource?             @relation("KnowledgeSourceActiveVersion")
  chunks    KnowledgeChunk[]
  attempts  KnowledgeProcessingAttempt[]

  @@unique([sourceId, version])
  @@index([sourceId, status])
}

model KnowledgeChunk {
  id            String               @id @default(cuid())
  /// Denormalized from version.sourceId purely for fast source-scoped filtering — versionId is the canonical relation, this is never written independently of it.
  sourceId      String
  versionId     String
  order         Int
  text          String               @db.Text
  title         String?
  heading       String?
  page          Int?
  section       String?
  rowIndex      Int?
  jsonPath      String?
  /// Human-readable location for citations ("Página 3", "Fila 12", "campos.precio") — derived once at chunk time, never recomputed at display time.
  locationLabel String?
  charStart     Int?
  charEnd       Int?
  checksum      String
  sizeChars     Int
  tokenEstimate Int
  status        KnowledgeChunkStatus @default(PENDING)
  createdAt     DateTime             @default(now())

  version          KnowledgeSourceVersion     @relation(fields: [versionId], references: [id], onDelete: Cascade)
  citations        KnowledgeCitation[]
  contentCitations ContentKnowledgeCitation[]
  queryResults     KnowledgeQueryResult[]

  /// Generated (STORED) Postgres tsvector column, added by hand in the migration SQL with a GIN index — real full-text search with zero extension dependency (spec section 15: "no habilites extensiones sin comprobar compatibilidad"). DB-managed only; Prisma never writes to it.
  searchVector Unsupported("tsvector")?

  @@unique([versionId, order])
  @@index([sourceId])
  @@index([versionId, status])
}

model KnowledgeQuery {
  id                   String                  @id @default(cuid())
  projectId            String
  askedById            String
  question             String                  @db.Text
  /// Default "solo fuentes seleccionadas" (spec section 19) — general knowledge is opt-in per query.
  mode                 KnowledgeQueryMode      @default(SOURCES_ONLY)
  collectionIds        String[]                @default([])
  sourceIds            String[]                @default([])
  brandProfileId       String?
  language             String?
  maxSources           Int?
  status               KnowledgeQueryStatus    @default(PENDING)
  executionToken       String?
  answer               String?                 @db.Text
  supportedFacts       String[]                @default([])
  inferences           String[]                @default([])
  recommendations      String[]                @default([])
  missingInfo          String[]                @default([])
  generalKnowledgeUsed Boolean                 @default(false)
  errorMessage         String?
  errorCategory        KnowledgeErrorCategory?
  isArchived           Boolean                 @default(false)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  project                          Project                           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  askedBy                          User                              @relation("KnowledgeQueryAskedBy", fields: [askedById], references: [id])
  brandProfile                     BrandProfile?                     @relation(fields: [brandProfileId], references: [id], onDelete: SetNull)
  results                          KnowledgeQueryResult[]
  citations                        KnowledgeCitation[]
  performanceRecommendationActions PerformanceRecommendationAction[]
  mbScenarioActions                MarketingBrainScenarioAction[]

  @@index([projectId, createdAt])
  @@index([projectId, askedById])
}

model KnowledgeQueryResult {
  id       String  @id @default(cuid())
  queryId  String
  chunkId  String?
  sourceId String
  rank     Int
  score    Float
  snippet  String  @db.Text

  query KnowledgeQuery  @relation(fields: [queryId], references: [id], onDelete: Cascade)
  chunk KnowledgeChunk? @relation(fields: [chunkId], references: [id], onDelete: SetNull)

  @@unique([queryId, chunkId])
  @@index([queryId])
}

/// A citation attached to a KnowledgeQuery's answer. Deliberately self-contained (title/quote/location snapshotted directly on the row) so it keeps meaning even after its source/chunk is later deleted — see spec section 34: "no rompe consultas históricas: estas deben mostrar 'fuente eliminada'".
model KnowledgeCitation {
  id                  String                @id @default(cuid())
  queryId             String
  chunkId             String?
  sourceId            String?
  order               Int
  label               String
  citationType        KnowledgeCitationType @default(CONTEXTUAL)
  quoteSnapshot       String                @db.Text
  sourceTitleSnapshot String
  locationLabel       String?
  createdAt           DateTime              @default(now())

  query  KnowledgeQuery   @relation(fields: [queryId], references: [id], onDelete: Cascade)
  chunk  KnowledgeChunk?  @relation(fields: [chunkId], references: [id], onDelete: SetNull)
  source KnowledgeSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@index([queryId])
  @@index([sourceId])
}

/// A citation inserted into a ContentItem from the AI Editor Pro Knowledge panel (spec section 25) — same self-contained-snapshot precedent as KnowledgeCitation.
model ContentKnowledgeCitation {
  id                  String                @id @default(cuid())
  contentItemId       String
  chunkId             String?
  sourceId            String?
  insertedById        String
  citationType        KnowledgeCitationType @default(DIRECT)
  quoteSnapshot       String                @db.Text
  sourceTitleSnapshot String
  locationLabel       String?
  createdAt           DateTime              @default(now())

  contentItem ContentItem      @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  chunk       KnowledgeChunk?  @relation(fields: [chunkId], references: [id], onDelete: SetNull)
  source      KnowledgeSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  insertedBy  User             @relation("ContentKnowledgeCitationInsertedBy", fields: [insertedById], references: [id])

  @@index([contentItemId])
  @@index([sourceId])
}

/// Append-only audit log of every processing-stage attempt (spec section 30/31) — the actual concurrency guard lives on KnowledgeSourceVersion.executionToken/currentStage; this table is the visible history + retry diagnostics.
model KnowledgeProcessingAttempt {
  id             String                           @id @default(cuid())
  sourceId       String
  versionId      String
  stage          KnowledgeProcessingStage
  status         KnowledgeProcessingAttemptStatus @default(PENDING)
  executionToken String?
  attemptNumber  Int                              @default(1)
  errorMessage   String?
  errorCategory  KnowledgeErrorCategory?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime                         @default(now())

  version KnowledgeSourceVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([versionId, stage])
  @@index([sourceId])
}

// ---------------------------------------------------------------------------
// AI Automation Center (Fase 33) — decides WHEN and WHY an existing AI
// Workflow runs (manually, on a schedule, on an internal event, via webhook,
// chained after another run, gated by conditions/approvals/waits) and drives
// it through the REAL execution engine (see beginFreshRun/
// prepareWorkflowStepCore, exported from src/server/actions/
// workflow-execution.ts specifically for this reuse) — never a second
// workflow engine. Named "WorkflowAutomation*" rather than "Automation*"
// because a much older, simpler `Automation`/`AutomationAction`/
// `AutomationRun` model already exists for a handful of basic
// scheduled/manual actions (notifications, monitor checks, link checks);
// that legacy feature's models/services are untouched by this phase — only
// its page.tsx is superseded, since the project nav's "Automatizaciones"
// entry now points at this richer system instead (see the file-level note
// in src/lib/navigation.ts).
// ---------------------------------------------------------------------------

enum WorkflowAutomationStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
  ERROR
}

enum WorkflowAutomationTriggerType {
  MANUAL
  SCHEDULE_ONCE
  SCHEDULE_RECURRING
  INTERNAL_EVENT
  WEBHOOK
  WORKFLOW_COMPLETED
  AGENT_RUN_COMPLETED
  MARKETING_BRAIN_COMPLETED
  KNOWLEDGE_SOURCE_READY
  CONTENT_STATUS_CHANGED
  CAMPAIGN_DATE_REACHED
  SOCIAL_POST_STATUS_CHANGED
}

enum WorkflowAutomationTriggerStatus {
  ACTIVE
  PAUSED
  ERROR
}

enum WorkflowAutomationErrorPolicy {
  STOP
  RETRY
  CONTINUE
  WAIT_FOR_REVIEW
}

enum WorkflowAutomationRunStatus {
  QUEUED
  WAITING_FOR_SCHEDULE
  WAITING_FOR_CONDITION
  WAITING_FOR_APPROVAL
  RUNNING
  RETRY_SCHEDULED
  PARTIALLY_COMPLETED
  COMPLETED
  FAILED
  TIMED_OUT
  CANCELLED
  SKIPPED
  ARCHIVED
}

enum WorkflowAutomationRunAttemptStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum WorkflowAutomationApprovalStatus {
  PENDING
  APPROVED
  CHANGES_REQUESTED
  REJECTED
  EXPIRED
  CANCELLED
}

enum WorkflowAutomationWaitKind {
  DURATION
  UNTIL_DATE
  APPROVAL
  EVENT
  CONDITION
}

enum WorkflowAutomationWaitStatus {
  PENDING
  SATISFIED
  TIMED_OUT
  CANCELLED
}

enum WorkflowAutomationConditionOperator {
  EQUALS
  NOT_EQUALS
  CONTAINS
  NOT_CONTAINS
  STARTS_WITH
  ENDS_WITH
  GREATER_THAN
  GREATER_THAN_OR_EQUAL
  LESS_THAN
  LESS_THAN_OR_EQUAL
  IS_EMPTY
  IS_NOT_EMPTY
  IN
  NOT_IN
  CHANGED_FROM
  CHANGED_TO
  EXISTS
  NOT_EXISTS
}

enum WorkflowAutomationConditionGroupOperator {
  AND
  OR
}

enum WorkflowAutomationEventStatus {
  PENDING
  PROCESSING
  PROCESSED
  PARTIALLY_PROCESSED
  FAILED
  IGNORED
  ARCHIVED
}

enum WorkflowAutomationEventDeliveryStatus {
  PENDING
  MATCHED
  SKIPPED_CONDITION
  SKIPPED_LOOP
  CREATED_RUN
  FAILED
}

enum WorkflowAutomationWebhookDeliveryStatus {
  RECEIVED
  REJECTED
  PROCESSED
}

enum WorkflowAutomationScheduleExceptionAction {
  SKIP
  RESCHEDULE
}

model WorkflowAutomation {
  id                         String                        @id @default(cuid())
  projectId                  String
  createdById                String
  name                       String
  description                String?                       @db.Text
  status                     WorkflowAutomationStatus      @default(DRAFT)
  workflowId                 String
  /// null = always run the workflow's currently-active PUBLISHED revision; set = pinned to a specific past revision — the UI shows "usa una versión anterior" and offers "actualizar" (spec section 3).
  pinnedWorkflowRevisionId   String?
  errorPolicy                WorkflowAutomationErrorPolicy @default(STOP)
  maxRetryAttempts           Int                           @default(3)
  retryBaseDelayMs           Int                           @default(60000)
  retryDelayMultiplier       Float                         @default(2)
  retryMaxDelayMs            Int                           @default(3600000)
  executionTimeoutMs         Int?
  approvalTimeoutMs          Int?
  waitTimeoutMs              Int?
  requireApprovalBeforeStart Boolean                       @default(false)
  notifyOnCompletion         Boolean                       @default(false)
  notifyOnFailure            Boolean                       @default(true)
  timezone                   String                        @default("UTC")
  consecutiveFailureCount    Int                           @default(0)
  pausedReason               String?                       @db.Text
  pausedAt                   DateTime?
  pausedBySystem             Boolean                       @default(false)
  archivedAt                 DateTime?
  lastRunAt                  DateTime?
  nextRunAt                  DateTime?
  createdAt                  DateTime                      @default(now())
  updatedAt                  DateTime                      @updatedAt

  project        Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy      User              @relation("WorkflowAutomationCreatedBy", fields: [createdById], references: [id])
  workflow       Workflow          @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  pinnedRevision WorkflowRevision? @relation(fields: [pinnedWorkflowRevisionId], references: [id], onDelete: SetNull)

  trigger                          WorkflowAutomationTrigger?
  conditionGroups                  WorkflowAutomationConditionGroup[]
  inputMappings                    WorkflowAutomationInputMapping[]
  runs                             WorkflowAutomationRun[]
  scheduleExceptions               WorkflowAutomationScheduleException[]
  notificationStates               WorkflowAutomationNotificationState[]
  eventDeliveries                  WorkflowAutomationEventDelivery[]
  webhookDeliveries                WorkflowAutomationWebhookDelivery[]
  performanceRecommendationActions PerformanceRecommendationAction[]

  @@index([projectId, status])
  @@index([workflowId])
  @@index([status, nextRunAt])
}

model WorkflowAutomationTrigger {
  id                     String                          @id @default(cuid())
  automationId           String                          @unique
  type                   WorkflowAutomationTriggerType
  status                 WorkflowAutomationTriggerStatus @default(ACTIVE)
  /// Type-specific validated configuration (schedule date/tz/recurrence rule, event type key + field filters, chained-run source/outcome filters...) — always generated from validated structured input, never raw cron/RRULE typed freely by the user (spec section 7). See src/lib/automations/recurrence.ts.
  config                 Json
  /// WEBHOOK triggers only — opaque public id used in the receiving URL, never the automation's own internal id (spec section 11).
  webhookPublicId        String?                         @unique
  /// WEBHOOK triggers only — AES-256-GCM encrypted (src/lib/security/encryption.ts, the same utility already used for WordPress/GitHub/social credentials) — never returned again after creation except via explicit rotation.
  webhookSecretEncrypted String?
  webhookReceivedCount   Int                             @default(0)
  webhookLastReceivedAt  DateTime?
  lastFiredAt            DateTime?
  nextFiredAt            DateTime?
  firedCount             Int                             @default(0)
  lastErrorMessage       String?
  createdAt              DateTime                        @default(now())
  updatedAt              DateTime                        @updatedAt

  automation WorkflowAutomation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@index([type, status, nextFiredAt])
}

model WorkflowAutomationConditionGroup {
  id            String                                   @id @default(cuid())
  automationId  String
  parentGroupId String?
  operator      WorkflowAutomationConditionGroupOperator @default(AND)
  order         Int                                      @default(0)
  createdAt     DateTime                                 @default(now())

  automation  WorkflowAutomation                 @relation(fields: [automationId], references: [id], onDelete: Cascade)
  parentGroup WorkflowAutomationConditionGroup?  @relation("WorkflowAutomationConditionGroupChildren", fields: [parentGroupId], references: [id], onDelete: Cascade)
  childGroups WorkflowAutomationConditionGroup[] @relation("WorkflowAutomationConditionGroupChildren")
  conditions  WorkflowAutomationCondition[]

  @@index([automationId])
  @@index([parentGroupId])
}

model WorkflowAutomationCondition {
  id        String                              @id @default(cuid())
  groupId   String
  field     String
  operator  WorkflowAutomationConditionOperator
  /// The comparison value(s) — string/number/boolean, or an array for IN/NOT_IN — size-limited at write time, never eval'd (spec section 15).
  value     Json?
  order     Int                                 @default(0)
  createdAt DateTime                            @default(now())

  group WorkflowAutomationConditionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
}

model WorkflowAutomationInputMapping {
  id               String   @id @default(cuid())
  automationId     String
  targetVariable   String
  /// "EVENT_FIELD" | "STATIC" | "RESOURCE" | "TEMPLATE" — see src/lib/automations/mapping.ts.
  sourceKind       String
  sourceExpression String   @db.Text
  transform        String?
  defaultValue     String?
  order            Int      @default(0)
  createdAt        DateTime @default(now())

  automation WorkflowAutomation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@unique([automationId, targetVariable])
  @@index([automationId])
}

model WorkflowAutomationRun {
  id                String                        @id @default(cuid())
  automationId      String
  projectId         String
  workflowId        String
  workflowRunId     String?                       @unique
  triggerType       WorkflowAutomationTriggerType
  eventId           String?
  createdById       String?
  status            WorkflowAutomationRunStatus   @default(QUEUED)
  attempt           Int                           @default(1)
  nextRetryAt       DateTime?
  inputs            Json
  /// Frozen copy of the trigger's own config + the matched event/webhook/chain summary at activation time — never re-derived from a possibly-since-edited trigger (same "snapshot" precedent as WorkflowRun.workflowSnapshot).
  triggerSnapshot   Json
  idempotencyKey    String
  /// The AutomationRun (if any) whose own workflow execution produced the event/chain that caused THIS run — loop-detection ancestry (spec section 31).
  causationId       String?
  /// Shared across an entire causation chain, from the very first run that started it — "how many automations fired because of this one action" becomes a single indexed query.
  correlationId     String
  chainDepth        Int                           @default(0)
  lastErrorMessage  String?
  lastErrorCategory String?
  executionToken    String?
  lockedAt          DateTime?
  lockedBy          String?
  lockExpiresAt     DateTime?
  startedAt         DateTime?
  completedAt       DateTime?
  durationMs        Int?
  createdAt         DateTime                      @default(now())
  updatedAt         DateTime                      @updatedAt

  automation  WorkflowAutomation             @relation(fields: [automationId], references: [id], onDelete: Cascade)
  project     Project                        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workflow    Workflow                       @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  workflowRun WorkflowRun?                   @relation(fields: [workflowRunId], references: [id], onDelete: SetNull)
  event       WorkflowAutomationEvent?       @relation(fields: [eventId], references: [id], onDelete: SetNull)
  createdBy   User?                          @relation("WorkflowAutomationRunCreatedBy", fields: [createdById], references: [id])
  causedBy    WorkflowAutomationRun?         @relation("WorkflowAutomationRunCausation", fields: [causationId], references: [id], onDelete: SetNull)
  causedRuns  WorkflowAutomationRun[]        @relation("WorkflowAutomationRunCausation")
  attempts    WorkflowAutomationRunAttempt[]
  approvals   WorkflowAutomationApproval[]
  waits       WorkflowAutomationWait[]

  @@unique([automationId, idempotencyKey])
  @@index([projectId, status])
  @@index([automationId, status])
  @@index([status, nextRetryAt])
  @@index([status, lockExpiresAt])
  @@index([correlationId])
  @@index([eventId])
}

model WorkflowAutomationRunAttempt {
  id            String                             @id @default(cuid())
  runId         String
  attemptNumber Int
  status        WorkflowAutomationRunAttemptStatus @default(RUNNING)
  startedAt     DateTime                           @default(now())
  completedAt   DateTime?
  errorMessage  String?
  errorCategory String?

  run WorkflowAutomationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
}

model WorkflowAutomationApproval {
  id             String                           @id @default(cuid())
  runId          String
  stepLabel      String?
  requiredUserId String?
  status         WorkflowAutomationApprovalStatus @default(PENDING)
  comment        String?                          @db.Text
  decidedById    String?
  decidedAt      DateTime?
  expiresAt      DateTime?
  createdAt      DateTime                         @default(now())
  updatedAt      DateTime                         @updatedAt

  run          WorkflowAutomationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  requiredUser User?                 @relation("WorkflowAutomationApprovalRequiredUser", fields: [requiredUserId], references: [id], onDelete: SetNull)
  decidedBy    User?                 @relation("WorkflowAutomationApprovalDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([runId, status])
}

model WorkflowAutomationWait {
  id        String                       @id @default(cuid())
  runId     String
  kind      WorkflowAutomationWaitKind
  wakeAt    DateTime?
  condition Json?
  eventKey  String?
  timeoutAt DateTime?
  status    WorkflowAutomationWaitStatus @default(PENDING)
  attempts  Int                          @default(0)
  createdAt DateTime                     @default(now())
  updatedAt DateTime                     @updatedAt

  run WorkflowAutomationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([status, wakeAt])
  @@index([runId])
}

model WorkflowAutomationScheduleException {
  id            String                                    @id @default(cuid())
  automationId  String
  occurrenceAt  DateTime
  action        WorkflowAutomationScheduleExceptionAction
  rescheduledTo DateTime?
  createdById   String
  createdAt     DateTime                                  @default(now())

  automation WorkflowAutomation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  createdBy  User               @relation("WorkflowAutomationScheduleExceptionCreatedBy", fields: [createdById], references: [id])

  @@unique([automationId, occurrenceAt])
}

model WorkflowAutomationWebhookDelivery {
  id            String                                  @id @default(cuid())
  automationId  String
  deliveryId    String
  status        WorkflowAutomationWebhookDeliveryStatus @default(RECEIVED)
  bodySizeBytes Int
  errorMessage  String?
  eventId       String?
  receivedAt    DateTime                                @default(now())

  automation WorkflowAutomation       @relation(fields: [automationId], references: [id], onDelete: Cascade)
  event      WorkflowAutomationEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@unique([automationId, deliveryId])
  @@index([automationId, receivedAt])
}

model WorkflowAutomationEvent {
  id             String                        @id @default(cuid())
  projectId      String
  type           String
  schemaVersion  Int                           @default(1)
  resourceType   String
  resourceId     String?
  actorId        String?
  /// Minimal, non-secret fields only — never a full resource dump (spec sections 8/9/16).
  payload        Json
  idempotencyKey String                        @unique
  occurredAt     DateTime                      @default(now())
  status         WorkflowAutomationEventStatus @default(PENDING)
  processedAt    DateTime?
  attempts       Int                           @default(0)
  errorMessage   String?
  causationId    String?
  correlationId  String?
  lockedAt       DateTime?
  lockedBy       String?
  lockExpiresAt  DateTime?
  createdAt      DateTime                      @default(now())

  project           Project                             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor             User?                               @relation("WorkflowAutomationEventActor", fields: [actorId], references: [id], onDelete: SetNull)
  deliveries        WorkflowAutomationEventDelivery[]
  runs              WorkflowAutomationRun[]
  webhookDeliveries WorkflowAutomationWebhookDelivery[]

  @@index([projectId, status])
  @@index([status, lockExpiresAt])
  @@index([projectId, type, occurredAt])
}

model WorkflowAutomationEventDelivery {
  id              String                                @id @default(cuid())
  eventId         String
  automationId    String
  status          WorkflowAutomationEventDeliveryStatus @default(PENDING)
  automationRunId String?
  errorMessage    String?
  createdAt       DateTime                              @default(now())

  event      WorkflowAutomationEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  automation WorkflowAutomation      @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@unique([eventId, automationId])
  @@index([automationId])
}

model WorkflowAutomationNotificationState {
  id           String   @id @default(cuid())
  automationId String
  runId        String?
  kind         String
  dedupeKey    String   @unique
  lastSentAt   DateTime @default(now())

  automation WorkflowAutomation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@index([automationId])
}

// =============================================================================
// AI Performance Intelligence & Optimization Center (Fase 34) — measures,
// compares, and interprets everything already produced by the platform.
// Never a parallel Campaign/Content/Publication/Agent/Workflow/Automation
// system: every model below only ever REFERENCES those, via real FKs where
// integrity/queries matter (spec section 44) and a resourceType/resourceId
// pair for the rest. No commercial/billing concept exists anywhere here.
// =============================================================================

/// Where a metric value actually came from (spec section 2) — every record
/// carries this, and the UI must never present one origin as another.
enum PerformanceMetricOrigin {
  INTERNAL
  MANUAL
  CSV_IMPORT
  JSON_IMPORT
  EXTERNAL_PROVIDER
  CALCULATED
  ESTIMATED
}

enum PerformanceResourceType {
  CONTENT_ITEM
  CONTENT_VERSION
  CAMPAIGN
  CAMPAIGN_CONTENT_PIECE
  SOCIAL_POST
  EXPERIMENT_VARIANT
  PLATFORM
  PROJECT
}

enum PerformanceMetricCategory {
  CONTENT
  CAMPAIGN
  SOCIAL
  AUTOMATION
  KNOWLEDGE
  CUSTOM
  /// Fase 39 — web analytics / organic search metrics (Google Analytics 4, Google Search Console) — genuinely distinct from SOCIAL (platform engagement) or CONTENT (internal authoring metrics).
  ANALYTICS
}

enum PerformanceMetricUnit {
  COUNT
  PERCENTAGE
  SECONDS
  CURRENCY
  RATIO
  SCORE
  TEXT
}

enum PerformanceMetricDirection {
  HIGHER_IS_BETTER
  LOWER_IS_BETTER
  NEUTRAL
}

enum PerformanceMetricAggregation {
  SUM
  AVERAGE
  MEDIAN
  MAX
  MIN
  LAST
  RATE
}

/// Spec section 10's exact period list.
enum PerformancePeriodGranularity {
  DAY
  WEEK
  MONTH
  QUARTER
  YEAR
  CAMPAIGN
  EXPERIMENT
  PUBLICATION
  CUSTOM_RANGE
}

enum PerformanceMetricRevisionAction {
  CREATED
  UPDATED
  REPLACED
  MERGED
  ARCHIVED
  DELETED
}

enum PerformanceImportKind {
  CSV
  JSON
}

/// Persistent, resumable processing stages (spec section 45) — never a single long-lived HTTP request.
enum PerformanceImportStage {
  REGISTERED
  VALIDATING
  NORMALIZING
  MATCHING_RESOURCES
  IMPORTING
  AGGREGATING
  ANALYZING
  FINALIZING
}

enum PerformanceImportStatus {
  DRAFT
  MAPPING
  VALIDATING
  READY
  IMPORTING
  PARTIALLY_COMPLETED
  COMPLETED
  FAILED
  CANCELLED
  ARCHIVED
}

enum PerformanceImportRowStatus {
  PENDING
  VALID
  INVALID
  DUPLICATE
  IMPORTED
  SKIPPED
}

enum PerformanceDuplicatePolicy {
  SKIP
  REPLACE
  MERGE_SUM
  KEEP_BOTH
}

enum PerformanceGoalType {
  MINIMUM
  MAXIMUM
  RANGE
  GROWTH
  MAINTAIN
  CUSTOM
}

enum PerformanceGoalStatus {
  ACTIVE
  REACHED
  MISSED
  EXPIRED
  ARCHIVED
}

enum PerformanceBenchmarkSource {
  INTERNAL_AVERAGE
  INTERNAL_MEDIAN
  BEST_HISTORICAL
  PREVIOUS_PERIOD
  PREVIOUS_CAMPAIGN
  MANUAL_VALUE
}

enum PerformanceExperimentType {
  TITLE
  HOOK
  CTA
  DESCRIPTION
  FORMAT
  LENGTH
  TONE
  PUBLISHING_TIME
  PLATFORM_ADAPTATION
  CONTENT_VERSION
  CUSTOM
}

enum PerformanceExperimentStatus {
  DRAFT
  READY
  RUNNING
  PAUSED
  COMPLETED
  INCONCLUSIVE
  CANCELLED
  ARCHIVED
}

enum PerformanceExperimentVariantStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
}

enum PerformanceRecommendationCategory {
  CONTENT
  CAMPAIGN
  SOCIAL
  AUTOMATION
  KNOWLEDGE
  EXPERIMENT
  DATA_QUALITY
}

enum PerformanceRecommendationPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum PerformanceRecommendationSource {
  RULE
  AI
  EXPERIMENT
}

enum PerformanceRecommendationStatus {
  NEW
  REVIEWING
  ACCEPTED
  REJECTED
  APPLIED
  DISMISSED
  EXPIRED
  ARCHIVED
}

enum PerformanceRecommendationActionType {
  INTERNAL_TASK
  AGENT_RUN
  AGENT_TEAM_RUN
  WORKFLOW_RUN
  WORKFLOW_AUTOMATION
  EXPERIMENT
  CONTENT_VERSION
  CAMPAIGN_CONTENT_PIECE
  SOCIAL_POST
  CONTENT_UPDATE
  KNOWLEDGE_QUERY
}

enum PerformanceRecommendationActionStatus {
  PENDING
  CONFIRMED
  CREATED
  FAILED
  CANCELLED
}

enum PerformanceAnomalySeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum PerformanceAnomalyMethod {
  STDDEV
  IQR
  PERCENT_CHANGE
  MISSING_DATA
  ACTIVITY_DROP
  ACTIVITY_SPIKE
}

enum PerformanceAnomalyStatus {
  OPEN
  REVIEWING
  CONFIRMED
  DISMISSED
  RESOLVED
  ARCHIVED
}

enum PerformanceReportType {
  WEEKLY
  MONTHLY
  CAMPAIGN
  CONTENT
  PLATFORM
  EXPERIMENT
  CUSTOM
}

enum PerformanceReportStatus {
  DRAFT
  GENERATING
  COMPLETED
  FAILED
  ARCHIVED
}

/// Project-scoped CUSTOM metric definitions ONLY — built-in metric keys live
/// in the code registry (src/lib/performance/metrics-catalog.ts) and are
/// never persisted here (spec section 8: "no permitas claves arbitrarias
/// salvo mediante custom_metric validada").
model PerformanceMetricDefinition {
  id                           String                       @id @default(cuid())
  projectId                    String
  createdById                  String
  key                          String
  name                         String
  description                  String?                      @db.Text
  category                     PerformanceMetricCategory    @default(CUSTOM)
  unit                         PerformanceMetricUnit
  direction                    PerformanceMetricDirection   @default(HIGHER_IS_BETTER)
  aggregation                  PerformanceMetricAggregation @default(SUM)
  compatibleResourceTypes      PerformanceResourceType[]    @default([])
  compatiblePlatforms          String[]                     @default([])
  supportsCumulative           Boolean                      @default(true)
  supportsAverage              Boolean                      @default(true)
  supportsPercentage           Boolean                      @default(false)
  supportsComparison           Boolean                      @default(true)
  requiresNumeratorDenominator Boolean                      @default(false)
  expectedMin                  Decimal?                     @db.Decimal(18, 4)
  expectedMax                  Decimal?                     @db.Decimal(18, 4)
  isArchived                   Boolean                      @default(false)
  createdAt                    DateTime                     @default(now())
  updatedAt                    DateTime                     @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User    @relation("PerformanceMetricDefinitionCreatedBy", fields: [createdById], references: [id])

  @@unique([projectId, key])
  @@index([projectId, category])
}

/// The core metric row (spec sections 2/6/7/8/44) — every internal
/// calculation, manual entry, CSV/JSON import row, or externally-imported
/// value becomes exactly one of these. Explicit FKs for every resource type
/// the spec calls out; resourceType/resourceId cover PLATFORM/PROJECT-level
/// aggregates that have no single owning row.
model PerformanceMetricRecord {
  id                     String                       @id @default(cuid())
  projectId              String
  createdById            String
  source                 PerformanceMetricOrigin
  metricKey              String
  resourceType           PerformanceResourceType
  /// Generic fallback identifier for PLATFORM/PROJECT-level aggregates — never authoritative when a specific FK below is set.
  resourceId             String?
  contentItemId          String?
  contentVersionId       String?
  campaignId             String?
  campaignContentPieceId String?
  socialPostId           String?
  experimentVariantId    String?
  platform               String?
  value                  Decimal                      @db.Decimal(18, 4)
  unit                   PerformanceMetricUnit
  currency               String?
  measuredAt             DateTime
  periodStart            DateTime
  periodEnd              DateTime
  granularity            PerformancePeriodGranularity @default(DAY)
  /// Required for EXTERNAL_PROVIDER/CSV_IMPORT/JSON_IMPORT (e.g. "instagram", "tiktok") — null for INTERNAL/CALCULATED (spec section 2).
  provider               String?
  externalReference      String?
  /// "método de incorporación" (spec section 2) — e.g. "manual_form", "csv_import", "json_import", "internal_calculation".
  method                 String
  notes                  String?                      @db.Text
  evidenceFileAssetId    String?
  importId               String?
  /// Stable dedup key over projectId+resourceType+resourceId+platform+metricKey+measuredAt+periodStart+periodEnd+externalReference+source (spec section 15) — enforced uniquely at the DB level, never solely via a prior-check.
  idempotencyKey         String                       @unique
  isArchived             Boolean                      @default(false)
  createdAt              DateTime                     @default(now())
  updatedAt              DateTime                     @updatedAt

  project              Project                       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy            User                          @relation("PerformanceMetricRecordCreatedBy", fields: [createdById], references: [id])
  contentItem          ContentItem?                  @relation(fields: [contentItemId], references: [id], onDelete: SetNull)
  contentVersion       ContentVersion?               @relation(fields: [contentVersionId], references: [id], onDelete: SetNull)
  campaign             Campaign?                     @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  campaignContentPiece CampaignContentPiece?         @relation(fields: [campaignContentPieceId], references: [id], onDelete: SetNull)
  socialPost           SocialPost?                   @relation(fields: [socialPostId], references: [id], onDelete: SetNull)
  experimentVariant    PerformanceExperimentVariant? @relation(fields: [experimentVariantId], references: [id], onDelete: SetNull)
  evidenceFileAsset    FileAsset?                    @relation(fields: [evidenceFileAssetId], references: [id], onDelete: SetNull)
  import               PerformanceImport?            @relation(fields: [importId], references: [id], onDelete: SetNull)
  sourceImportRow      PerformanceImportRow?
  revisions            PerformanceMetricRevision[]

  @@index([projectId, metricKey])
  @@index([projectId, resourceType, resourceId])
  @@index([contentItemId])
  @@index([campaignId])
  @@index([socialPostId])
  @@index([experimentVariantId])
  @@index([projectId, measuredAt])
  @@index([projectId, periodStart, periodEnd])
  @@index([importId])
}

/// Audit trail (spec section 43) — every manual edit, replace, or merge of a metric.
model PerformanceMetricRevision {
  id             String                          @id @default(cuid())
  metricRecordId String
  changedById    String
  action         PerformanceMetricRevisionAction
  previousValue  Decimal?                        @db.Decimal(18, 4)
  newValue       Decimal?                        @db.Decimal(18, 4)
  reason         String?                         @db.Text
  createdAt      DateTime                        @default(now())

  metricRecord PerformanceMetricRecord @relation(fields: [metricRecordId], references: [id], onDelete: Cascade)
  changedBy    User                    @relation("PerformanceMetricRevisionChangedBy", fields: [changedById], references: [id])

  @@index([metricRecordId])
}

/// A persisted, resumable CSV/JSON import job (spec sections 12-15/45-47) — never a single open HTTP request for a large file.
model PerformanceImport {
  id             String                   @id @default(cuid())
  projectId      String
  createdById    String
  kind           PerformanceImportKind
  status         PerformanceImportStatus  @default(DRAFT)
  stage          PerformanceImportStage   @default(REGISTERED)
  fileAssetId    String?
  /// Pasted JSON text only (CSV always comes from a real file) — size-bounded at validation time (spec section 13).
  rawText        String?                  @db.Text
  platform       String?
  resourceType   PerformanceResourceType?
  /// Column/JSON-path → {metricKey|field} mapping chosen in the wizard.
  mapping        Json?
  /// Delimiter, date format, duplicate policy, header row, JSON container path, etc.
  config         Json?
  totalRows      Int                      @default(0)
  validRows      Int                      @default(0)
  invalidRows    Int                      @default(0)
  importedRows   Int                      @default(0)
  skippedRows    Int                      @default(0)
  duplicateRows  Int                      @default(0)
  /// Small, safe, user-facing messages only — never a raw parser exception or stack trace.
  errorSummary   Json?
  executionToken String?
  lockedAt       DateTime?
  lockedBy       String?
  lockExpiresAt  DateTime?
  attempts       Int                      @default(0)
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  project       Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy     User                      @relation("PerformanceImportCreatedBy", fields: [createdById], references: [id])
  fileAsset     FileAsset?                @relation(fields: [fileAssetId], references: [id], onDelete: SetNull)
  rows          PerformanceImportRow[]
  metricRecords PerformanceMetricRecord[]

  @@index([projectId, status])
  @@index([status, lockExpiresAt])
}

model PerformanceImportRow {
  id             String                     @id @default(cuid())
  importId       String
  rowIndex       Int
  /// The raw parsed row (bounded size, sanitized of dangerous keys) — never executed, never containing __proto__/constructor/prototype (spec section 13).
  rawData        Json
  status         PerformanceImportRowStatus @default(PENDING)
  errorMessage   String?
  duplicateOfId  String?
  metricRecordId String?                    @unique
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  import       PerformanceImport        @relation(fields: [importId], references: [id], onDelete: Cascade)
  duplicateOf  PerformanceImportRow?    @relation("PerformanceImportRowDuplicate", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates   PerformanceImportRow[]   @relation("PerformanceImportRowDuplicate")
  metricRecord PerformanceMetricRecord? @relation(fields: [metricRecordId], references: [id], onDelete: SetNull)

  @@index([importId, status])
  @@index([importId, rowIndex])
}

model PerformanceGoal {
  id            String                  @id @default(cuid())
  projectId     String
  createdById   String
  resourceType  PerformanceResourceType @default(PROJECT)
  campaignId    String?
  contentItemId String?
  platform      String?
  metricKey     String
  type          PerformanceGoalType
  targetValue   Decimal?                @db.Decimal(18, 4)
  targetMin     Decimal?                @db.Decimal(18, 4)
  targetMax     Decimal?                @db.Decimal(18, 4)
  periodStart   DateTime
  periodEnd     DateTime
  status        PerformanceGoalStatus   @default(ACTIVE)
  reachedAt     DateTime?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  project            Project                         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy          User                            @relation("PerformanceGoalCreatedBy", fields: [createdById], references: [id])
  campaign           Campaign?                       @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  contentItem        ContentItem?                    @relation(fields: [contentItemId], references: [id], onDelete: SetNull)
  mbMeasurementPlans MarketingBrainMeasurementPlan[]

  @@index([projectId, status])
  @@index([campaignId])
}

model PerformanceBenchmark {
  id          String                     @id @default(cuid())
  projectId   String
  createdById String?
  metricKey   String
  source      PerformanceBenchmarkSource
  campaignId  String?
  label       String?
  value       Decimal                    @db.Decimal(18, 4)
  computedAt  DateTime                   @default(now())
  createdAt   DateTime                   @default(now())

  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User?     @relation("PerformanceBenchmarkCreatedBy", fields: [createdById], references: [id])
  campaign  Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([projectId, metricKey])
}

model PerformanceExperiment {
  id                  String                      @id @default(cuid())
  projectId           String
  createdById         String
  name                String
  hypothesis          String                      @db.Text
  objective           String?
  type                PerformanceExperimentType
  primaryMetricKey    String
  secondaryMetricKeys String[]                    @default([])
  resourceType        PerformanceResourceType
  contentItemId       String?
  campaignId          String?
  platform            String?
  periodStart         DateTime?
  periodEnd           DateTime?
  status              PerformanceExperimentStatus @default(DRAFT)
  expectedSampleSize  Int?
  completionCriteria  String?                     @db.Text
  winnerVariantId     String?                     @unique
  conclusion          String?                     @db.Text
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt

  project               Project                           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy             User                              @relation("PerformanceExperimentCreatedBy", fields: [createdById], references: [id])
  contentItem           ContentItem?                      @relation(fields: [contentItemId], references: [id], onDelete: SetNull)
  campaign              Campaign?                         @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  winnerVariant         PerformanceExperimentVariant?     @relation("PerformanceExperimentWinner", fields: [winnerVariantId], references: [id], onDelete: SetNull)
  variants              PerformanceExperimentVariant[]    @relation("PerformanceExperimentVariants")
  metrics               PerformanceExperimentMetric[]
  recommendations       PerformanceRecommendation[]
  recommendationActions PerformanceRecommendationAction[]
  reportResources       PerformanceReportResource[]

  @@index([projectId, status])
  @@index([campaignId])
  @@index([contentItemId])
}

model PerformanceExperimentVariant {
  id                  String                             @id @default(cuid())
  experimentId        String
  label               String
  isControl           Boolean                            @default(false)
  contentVersionId    String?
  socialPostId        String?
  text                String?                            @db.Text
  metadata            Json?
  createdByAgentRunId String?
  agentKeyUsed        String?
  confirmedById       String?
  startDate           DateTime?
  endDate             DateTime?
  manualExposure      Int?
  status              PerformanceExperimentVariantStatus @default(DRAFT)
  createdAt           DateTime                           @default(now())
  updatedAt           DateTime                           @updatedAt

  experiment        PerformanceExperiment         @relation("PerformanceExperimentVariants", fields: [experimentId], references: [id], onDelete: Cascade)
  wonExperiment     PerformanceExperiment?        @relation("PerformanceExperimentWinner")
  contentVersion    ContentVersion?               @relation(fields: [contentVersionId], references: [id], onDelete: SetNull)
  socialPost        SocialPost?                   @relation(fields: [socialPostId], references: [id], onDelete: SetNull)
  createdByAgentRun AiAgentRun?                   @relation("PerformanceExperimentVariantCreatedByAgentRun", fields: [createdByAgentRunId], references: [id], onDelete: SetNull)
  confirmedBy       User?                         @relation("PerformanceExperimentVariantConfirmedBy", fields: [confirmedById], references: [id])
  metricRecords     PerformanceMetricRecord[]
  metrics           PerformanceExperimentMetric[]

  @@index([experimentId])
}

/// A computed analysis snapshot per variant/metric (spec section 22) — distinct from the raw PerformanceMetricRecord rows that feed into it.
model PerformanceExperimentMetric {
  id           String   @id @default(cuid())
  experimentId String
  variantId    String
  metricKey    String
  sampleSize   Int
  mean         Decimal? @db.Decimal(18, 6)
  median       Decimal? @db.Decimal(18, 6)
  stddev       Decimal? @db.Decimal(18, 6)
  proportion   Decimal? @db.Decimal(9, 6)
  value        Decimal  @db.Decimal(18, 6)
  computedAt   DateTime @default(now())
  createdAt    DateTime @default(now())

  experiment PerformanceExperiment        @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  variant    PerformanceExperimentVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, metricKey])
  @@index([experimentId, metricKey])
}

model PerformanceRecommendation {
  id              String                            @id @default(cuid())
  projectId       String
  title           String
  description     String                            @db.Text
  category        PerformanceRecommendationCategory
  priority        PerformanceRecommendationPriority @default(MEDIUM)
  confidence      Decimal                           @db.Decimal(4, 3)
  source          PerformanceRecommendationSource   @default(RULE)
  ruleKey         String?
  rationale       String                            @db.Text
  evidence        Json
  resourceType    PerformanceResourceType?
  contentItemId   String?
  campaignId      String?
  socialPostId    String?
  experimentId    String?
  actionProposed  String                            @db.Text
  expectedOutcome String?                           @db.Text
  risk            String?                           @db.Text
  effortEstimate  String?
  status          PerformanceRecommendationStatus   @default(NEW)
  assignedToId    String?
  expiresAt       DateTime?
  idempotencyKey  String                            @unique
  createdAt       DateTime                          @default(now())
  updatedAt       DateTime                          @updatedAt

  project     Project                           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contentItem ContentItem?                      @relation(fields: [contentItemId], references: [id], onDelete: SetNull)
  campaign    Campaign?                         @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  socialPost  SocialPost?                       @relation(fields: [socialPostId], references: [id], onDelete: SetNull)
  experiment  PerformanceExperiment?            @relation(fields: [experimentId], references: [id], onDelete: SetNull)
  assignedTo  User?                             @relation("PerformanceRecommendationAssignedTo", fields: [assignedToId], references: [id])
  actions     PerformanceRecommendationAction[]

  @@index([projectId, status])
  @@index([contentItemId])
  @@index([campaignId])
}

/// Traceability from a recommendation to whatever real resource it produced (spec section 29/30) — never an automatic, unconfirmed mutation.
model PerformanceRecommendationAction {
  id                     String                                @id @default(cuid())
  recommendationId       String
  actionType             PerformanceRecommendationActionType
  status                 PerformanceRecommendationActionStatus @default(PENDING)
  agentRunId             String?
  workflowRunId          String?
  workflowAutomationId   String?
  experimentId           String?
  contentVersionId       String?
  campaignContentPieceId String?
  socialPostId           String?
  knowledgeQueryId       String?
  parameters             Json?
  performedById          String
  confirmedAt            DateTime?
  createdAt              DateTime                              @default(now())

  recommendation       PerformanceRecommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  agentRun             AiAgentRun?               @relation("PerformanceRecommendationActionAgentRun", fields: [agentRunId], references: [id], onDelete: SetNull)
  workflowRun          WorkflowRun?              @relation(fields: [workflowRunId], references: [id], onDelete: SetNull)
  workflowAutomation   WorkflowAutomation?       @relation(fields: [workflowAutomationId], references: [id], onDelete: SetNull)
  experiment           PerformanceExperiment?    @relation(fields: [experimentId], references: [id], onDelete: SetNull)
  contentVersion       ContentVersion?           @relation(fields: [contentVersionId], references: [id], onDelete: SetNull)
  campaignContentPiece CampaignContentPiece?     @relation(fields: [campaignContentPieceId], references: [id], onDelete: SetNull)
  socialPost           SocialPost?               @relation(fields: [socialPostId], references: [id], onDelete: SetNull)
  knowledgeQuery       KnowledgeQuery?           @relation(fields: [knowledgeQueryId], references: [id], onDelete: SetNull)
  performedBy          User                      @relation("PerformanceRecommendationActionPerformedBy", fields: [performedById], references: [id])

  @@index([recommendationId])
}

model PerformanceAnomaly {
  id                     String                     @id @default(cuid())
  projectId              String
  metricKey              String
  resourceType           PerformanceResourceType?
  contentItemId          String?
  campaignId             String?
  socialPostId           String?
  platform               String?
  detectedAt             DateTime                   @default(now())
  measuredAt             DateTime
  value                  Decimal                    @db.Decimal(18, 4)
  expectedValue          Decimal?                   @db.Decimal(18, 4)
  method                 PerformanceAnomalyMethod
  severity               PerformanceAnomalySeverity @default(MEDIUM)
  status                 PerformanceAnomalyStatus   @default(OPEN)
  dataQualityAtDetection String?
  explanation            String?                    @db.Text
  reviewedById           String?
  reviewedAt             DateTime?
  idempotencyKey         String                     @unique
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contentItem ContentItem? @relation(fields: [contentItemId], references: [id], onDelete: SetNull)
  campaign    Campaign?    @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  socialPost  SocialPost?  @relation(fields: [socialPostId], references: [id], onDelete: SetNull)
  reviewedBy  User?        @relation("PerformanceAnomalyReviewedBy", fields: [reviewedById], references: [id])

  @@index([projectId, status])
  @@index([contentItemId])
  @@index([campaignId])
}

model PerformanceReport {
  id            String                  @id @default(cuid())
  projectId     String
  createdById   String
  type          PerformanceReportType
  title         String
  periodStart   DateTime
  periodEnd     DateTime
  status        PerformanceReportStatus @default(DRAFT)
  filters       Json?
  summary       Json?
  aiSummary     String?                 @db.Text
  contentItemId String?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  project          Project                     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy        User                        @relation("PerformanceReportCreatedBy", fields: [createdById], references: [id])
  contentItem      ContentItem?                @relation(fields: [contentItemId], references: [id], onDelete: SetNull)
  resources        PerformanceReportResource[]
  knowledgeSources KnowledgeSource[]

  @@index([projectId, status])
}

model PerformanceReportResource {
  id            String                  @id @default(cuid())
  reportId      String
  resourceType  PerformanceResourceType
  campaignId    String?
  contentItemId String?
  socialPostId  String?
  experimentId  String?
  createdAt     DateTime                @default(now())

  report      PerformanceReport      @relation(fields: [reportId], references: [id], onDelete: Cascade)
  campaign    Campaign?              @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  contentItem ContentItem?           @relation(fields: [contentItemId], references: [id], onDelete: SetNull)
  socialPost  SocialPost?            @relation(fields: [socialPostId], references: [id], onDelete: SetNull)
  experiment  PerformanceExperiment? @relation(fields: [experimentId], references: [id], onDelete: SetNull)

  @@index([reportId])
}

// ---------------------------------------------------------------------------
// Customer Support Agent (Fase 40) — an official AI Agent Studio agent
// (see src/lib/agents/registry.ts "customer-support-agent") plus its own
// FAQ/knowledge/conversation/handoff models. Every AI-assisted answer is
// backed by a real AiAgentRun (CustomerSupportMessage.aiAgentRunId) created
// through the SAME orchestrator/governance/budget/audit machinery every
// other official agent uses — never a second execution engine. All models
// are project-scoped; nothing here is ever queried without a projectId
// filter (spec section 30: aislamiento multi-tenant).
// ---------------------------------------------------------------------------

enum CustomerSupportFaqStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// Where an APPROVED knowledge fragment came from — never an arbitrary external URL (spec section 12: only internal paths/permitted sources).
enum CustomerSupportKnowledgeSourceType {
  INTERNAL_PAGE
  DOCUMENTATION
  KNOWLEDGE_BASE_PUBLIC
  TOOL_DESCRIPTION
  HELP_PUBLIC
  MANUAL
}

enum CustomerSupportKnowledgeStatus {
  DRAFT
  APPROVED
  OUTDATED
  ARCHIVED
}

enum CustomerSupportKnowledgeVisibility {
  PUBLIC
  INTERNAL
}

enum CustomerSupportSyncStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum CustomerSupportConversationStatus {
  ACTIVE
  RESOLVED
  ESCALATED
  CLOSED
}

enum CustomerSupportMessageRole {
  VISITOR
  AGENT
  SYSTEM
}

/// Spec section 16 — the server ALWAYS reconstructs this; the AI never chooses its own type.
enum CustomerSupportResponseType {
  FAQ
  KNOWLEDGE
  AI_ASSISTED
  FALLBACK
}

/// Spec section 15 — a deterministic score the AI can never override.
enum CustomerSupportEvidenceLevel {
  HIGH
  MEDIUM
  LOW
  NONE
}

enum CustomerSupportFeedback {
  NONE
  POSITIVE
  NEGATIVE
}

/// REDACTED = a detected-secret pattern replaced the raw text before storage (spec section 18) — the raw text itself is never persisted anywhere, including here.
enum CustomerSupportMessageStatus {
  SENT
  REDACTED
}

enum CustomerSupportHandoffStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  CLOSED
}

enum CustomerSupportHandoffPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum CustomerSupportWidgetPosition {
  LEFT
  RIGHT
}

/// A closed set of pre-built visual presets — never arbitrary CSS/HTML/JS (spec section 6: "no permitas... CSS arbitrario").
enum CustomerSupportAppearanceTheme {
  DEFAULT
  MINIMAL
  BOLD
}

enum CustomerSupportTone {
  NEUTRAL
  FRIENDLY
  FORMAL
  CONCISE
}

/// Append-only counter rows for the public endpoint's rate limiter (spec section 26) — counted over a rolling window, mirroring the existing WorkflowAutomationWebhookDelivery precedent (src/server/services/automation-webhooks.ts) rather than a new in-memory/Redis dependency.
enum CustomerSupportRateLimitScope {
  SESSION_CREATE
  MESSAGE
  FEEDBACK
  HANDOFF
}

/// One row per project — activation gate lives here (spec section 23: real prerequisites, never a bare toggle). Never active by default (spec section 2).
model CustomerSupportConfig {
  id                         String                         @id @default(cuid())
  projectId                  String                         @unique
  /// Opaque, random, public-safe identifier the widget/public endpoint uses to resolve this project — never the internal cuid (spec section 25: "el visitante no puede suministrar projectId").
  publicId                   String                         @unique
  active                     Boolean                        @default(false)
  agentName                  String                         @default("Asistente de soporte")
  welcomeMessage             String                         @default("Hola, ¿en qué puedo ayudarte?")
  buttonText                 String                         @default("Ayuda")
  suggestedQuestions         String[]                       @default([])
  language                   String                         @default("es")
  tone                       CustomerSupportTone            @default(NEUTRAL)
  position                   CustomerSupportWidgetPosition  @default(RIGHT)
  /// Relative path prefixes; empty array = every non-excluded page (spec section 5/6: "páginas incluidas/excluidas").
  includedPaths              String[]                       @default([])
  excludedPaths              String[]                       @default([])
  allowedDomains             String[]                       @default([])
  offHoursMessage            String?
  humanHandoffEnabled        Boolean                        @default(true)
  maxMessagesPerConversation Int                            @default(30)
  retentionDays              Int                            @default(90)
  privacyText                String                         @default("Esta conversación puede guardarse para mejorar el soporte. No compartas contraseñas ni datos sensibles. Las respuestas pueden ser generadas por IA.")
  appearanceTheme            CustomerSupportAppearanceTheme @default(DEFAULT)
  /// Set once the in-dashboard test mode (spec section 22) completes at least one real exchange — a real activation prerequisite, not a bare flag (spec section 23).
  testCompletedAt            DateTime?
  activatedAt                DateTime?
  activatedById              String?
  createdAt                  DateTime                       @default(now())
  updatedAt                  DateTime                       @updatedAt

  project     Project                     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  activatedBy User?                       @relation("CustomerSupportConfigActivatedBy", fields: [activatedById], references: [id], onDelete: SetNull)
  publicSites CustomerSupportPublicSite[]

  @@index([publicId])
}

enum CustomerSupportPublicSiteStatus {
  PENDING
  VERIFIED
  ACTIVE
  DISABLED
}

/// Explicit, exclusive hostname -> project binding for the shared public marketing surface (Fase 40's second correction, spec section 2) — replaces the earlier "first activated project wins" heuristic. `normalizedHostname` is globally unique: a hostname can never resolve to two different projects, by real database constraint, not just application logic.
model CustomerSupportPublicSite {
  id                      String                          @id @default(cuid())
  projectId               String
  customerSupportConfigId String
  /// Exactly as entered by the MANAGER (for display only) — never used for lookups.
  hostname                String
  /// Lowercased, port-stripped, trailing-dot-stripped — the ONLY field ever queried for resolution.
  normalizedHostname      String                          @unique
  /// True for the hostname a project designates as its main public entry (informational — resolution itself only cares about ACTIVE status + the unique hostname match, never "primary" across different hostnames).
  isPrimary               Boolean                         @default(true)
  status                  CustomerSupportPublicSiteStatus @default(PENDING)
  verifiedAt              DateTime?
  createdById             String
  createdAt               DateTime                        @default(now())
  updatedAt               DateTime                        @updatedAt

  project               Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  customerSupportConfig CustomerSupportConfig @relation(fields: [customerSupportConfigId], references: [id], onDelete: Cascade)
  createdBy             User                  @relation("CustomerSupportPublicSiteCreatedBy", fields: [createdById], references: [id])

  @@index([projectId, status])
  @@index([customerSupportConfigId])
}

/// Only PUBLISHED rows are ever read by the widget/public endpoint (spec section 9: "el agente no puede publicar FAQ — la publicación debe ser humana").
model CustomerSupportFaq {
  id          String                   @id @default(cuid())
  projectId   String
  question    String
  answer      String                   @db.Text
  category    String?
  /// Alternate phrasings used for deterministic matching (spec section 10) — never a semantic/embedding match.
  aliases     String[]                 @default([])
  priority    Int                      @default(0)
  language    String                   @default("es")
  relatedLink String?
  status      CustomerSupportFaqStatus @default(DRAFT)
  authorId    String
  reviewerId  String?
  publishedAt DateTime?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author   User    @relation("CustomerSupportFaqAuthor", fields: [authorId], references: [id])
  reviewer User?   @relation("CustomerSupportFaqReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([projectId, status, language])
  @@index([projectId, category])
}

/// A MANAGER-approved fragment of knowledge the agent may use (spec section 11) — only APPROVED + visibility PUBLIC rows are ever read by the widget/public endpoint.
model CustomerSupportKnowledgeSource {
  id                String                             @id @default(cuid())
  projectId         String
  type              CustomerSupportKnowledgeSourceType
  title             String
  /// The internal relative path (e.g. "/legal/privacy") or manual reference this fragment was sourced from.
  sourceRef         String
  status            CustomerSupportKnowledgeStatus     @default(DRAFT)
  visibility        CustomerSupportKnowledgeVisibility @default(INTERNAL)
  language          String                             @default("es")
  excerpt           String?
  normalizedContent String                             @db.Text
  checksum          String
  discoveredAt      DateTime                           @default(now())
  lastUpdatedAt     DateTime                           @updatedAt
  lastSyncedAt      DateTime?
  approvedById      String?
  approvedAt        DateTime?
  createdAt         DateTime                           @default(now())

  project    Project                           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  approvedBy User?                             @relation("CustomerSupportKnowledgeSourceApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  syncRuns   CustomerSupportKnowledgeSyncRun[]

  @@unique([projectId, sourceRef])
  @@index([projectId, status, visibility])
}

/// History of sync attempts (spec section 12) — distinct from the source's current state, so "detectar cambios"/failures stay auditable over time.
model CustomerSupportKnowledgeSyncRun {
  id             String                    @id @default(cuid())
  projectId      String
  sourceId       String?
  requestedPath  String
  status         CustomerSupportSyncStatus @default(PENDING)
  changeDetected Boolean                   @default(false)
  errorMessage   String?
  startedAt      DateTime?
  completedAt    DateTime?
  startedById    String
  createdAt      DateTime                  @default(now())

  project   Project                         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  source    CustomerSupportKnowledgeSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  startedBy User                            @relation("CustomerSupportKnowledgeSyncRunStartedBy", fields: [startedById], references: [id])

  @@index([projectId, createdAt])
}

/// One visitor conversation. `publicId` is the only identifier ever exposed to the widget (spec section 17: "no uses IDs secuenciales").
model CustomerSupportConversation {
  id               String                            @id @default(cuid())
  projectId        String
  publicId         String                            @unique
  /// SHA-256 hash of a visitor session identifier — never a raw IP, never reversible (spec section 26).
  visitorKeyHash   String
  /// Set only when the visitor was an authenticated member (spec section 17: "visitante o usuario").
  userId           String?
  language         String                            @default("es")
  originPage       String?
  status           CustomerSupportConversationStatus @default(ACTIVE)
  category         String?
  lastResponseType CustomerSupportResponseType?
  lastEvidence     CustomerSupportEvidenceLevel?
  escalated        Boolean                           @default(false)
  /// Test-mode conversations (spec section 22) — excluded from public stats, never trigger real handoffs/notifications.
  isTest           Boolean                           @default(false)
  messageCount     Int                               @default(0)
  startedAt        DateTime                          @default(now())
  lastMessageAt    DateTime                          @default(now())
  closedAt         DateTime?

  project  Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user     User?                    @relation("CustomerSupportConversationUser", fields: [userId], references: [id], onDelete: SetNull)
  messages CustomerSupportMessage[]
  handoffs CustomerSupportHandoff[]

  @@index([projectId, status, isTest])
  @@index([projectId, startedAt])
  @@index([visitorKeyHash])
}

model CustomerSupportMessage {
  id             String                        @id @default(cuid())
  conversationId String
  /// Denormalized for direct project-scoped queries/isolation tests without a join (spec section 30).
  projectId      String
  role           CustomerSupportMessageRole
  /// Always sanitized before persistence — a detected secret is redacted first (spec section 18); never the raw visitor text when a secret was found.
  content        String                        @db.Text
  responseType   CustomerSupportResponseType?
  evidence       CustomerSupportEvidenceLevel?
  /// FAQ ids / knowledge source ids / internal links actually used — server-reconstructed, never AI-supplied (spec section 16).
  sourcesUsed    Json?
  feedback       CustomerSupportFeedback       @default(NONE)
  status         CustomerSupportMessageStatus  @default(SENT)
  /// Set only for an AI_ASSISTED AGENT message — the real AiAgentRun this answer was generated through (spec section 7: "no crear un motor paralelo").
  aiAgentRunId   String?
  latencyMs      Int?
  createdAt      DateTime                      @default(now())

  conversation CustomerSupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  project      Project                     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  aiAgentRun   AiAgentRun?                 @relation(fields: [aiAgentRunId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@index([projectId, createdAt])
}

/// A real human-attention request (spec section 19) — reuses `Notification` to alert authorized users, never a simulated email.
model CustomerSupportHandoff {
  id               String                         @id @default(cuid())
  conversationId   String
  projectId        String
  subject          String
  category         String?
  priority         CustomerSupportHandoffPriority @default(MEDIUM)
  /// Already sanitized/redacted before it ever reaches this row (spec section 18).
  sanitizedMessage String                         @db.Text
  originPage       String?
  status           CustomerSupportHandoffStatus   @default(OPEN)
  assignedToId     String?
  /// [{ authorId, note, createdAt }] — internal notes never surface in the public widget (spec section 19).
  internalNotes    Json?
  createdAt        DateTime                       @default(now())
  updatedAt        DateTime                       @updatedAt
  resolvedAt       DateTime?
  closedAt         DateTime?

  conversation CustomerSupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  project      Project                     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignedTo   User?                       @relation("CustomerSupportHandoffAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([projectId, status])
}

model CustomerSupportRateLimitEvent {
  id        String                        @id @default(cuid())
  keyHash   String
  scope     CustomerSupportRateLimitScope
  projectId String?
  createdAt DateTime                      @default(now())

  @@index([keyHash, scope, createdAt])
}
