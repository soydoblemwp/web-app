# -----------------------------------------------------------------------------
# AI Content Hub — environment variables
# Copy this file to .env and fill in real values. Never commit .env.
# -----------------------------------------------------------------------------

# --- Database (Neon Postgres) -------------------------------------------------
# Pooled connection string from the Neon dashboard (used by the app at runtime).
DATABASE_URL="postgresql://user:password@ep-example-12345.eu-central-1.aws.neon.tech/neondb?sslmode=require"
# Direct (non-pooled) connection string, used by Prisma Migrate.
DIRECT_URL="postgresql://user:password@ep-example-12345.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# --- Auth.js (NextAuth v5) ------------------------------------------------------
# REQUIRED. Signs and verifies session JWTs — without it, every login attempt
# fails with "MissingSecret" (src/lib/auth/config.ts, src/lib/auth/edge-config.ts
# both rely on NextAuth v5's automatic process.env.AUTH_SECRET detection; no
# `secret` option is set explicitly, so this is the only place it comes from).
# Generate a real value with:
#   openssl rand -base64 32
# or:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Never reuse the placeholder below as a real secret, and never commit a real
# value anywhere — only into your own untracked .env / .env.local.
AUTH_SECRET="replace-with-a-secure-random-secret"
# Public URL of the deployment. Use http://localhost:3000 in development.
APP_URL="http://localhost:3000"

# --- Encryption ------------------------------------------------------------
# Used to encrypt stored third-party credentials (WordPress, GitHub, social
# tokens) at rest. Generate with: openssl rand -base64 32
ENCRYPTION_KEY=""

# --- Email (Resend) ----------------------------------------------------------
# REQUIRED for real email delivery (account verification today; password
# recovery and other notifications will reuse the same config later — see
# src/lib/email/send-email.ts). Without RESEND_API_KEY, sendEmail() throws a
# clear error instead of silently no-oping or faking a successful send.
# Get a key from https://resend.com/api-keys (Dashboard > API Keys > Create).
# Never commit a real value anywhere — only into your own untracked .env / .env.local.
RESEND_API_KEY="re_replace_with_your_resend_api_key"
# The verified "from" address Resend will send as, e.g. "Acme <no-reply@yourdomain.com>".
# Must belong to a domain verified in the Resend dashboard (Domains > Add Domain);
# unverified domains will have every send rejected by Resend.
EMAIL_FROM="Tu Producto <no-reply@example.com>"

# --- AI ------------------------------------------------------------------------
# There is no AI provider to configure. Generation runs 100% locally in each
# user's browser via WebGPU (@mlc-ai/web-llm, see src/lib/ai/local/) — no API
# key, no secret, no environment variable, no server-side cost. The model id
# is centralized in src/lib/ai/local/model-config.ts, not here.

# --- GitHub integration (optional) ------------------------------------------
# Only needed if you want the GitHub integration's OAuth app flow later; the
# current version accepts a personal access token entered by the user instead.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# --- Scheduled tasks (Vercel Cron) -------------------------------------------
# Shared secret checked against the Authorization header on /api/cron/* routes.
CRON_SECRET=""

# --- AI Automation Center (Fase 33) -------------------------------------------
# Distinct from CRON_SECRET above — rotating one never disables the other.
# REQUIRED for automatic scheduling. Without it, GET /api/cron/workflow-automations
# stays disabled (503) — schedules, retries, waits, and the event outbox are
# never processed automatically. Manual execution keeps working regardless, and
# `npm run automations:process` (a local dev driver using the exact same
# service) can still process a batch on demand for testing.
# Generate with: openssl rand -base64 32
AUTOMATION_CRON_SECRET=""
# Optional Vercel Cron config to call the endpoint periodically — add to
# vercel.json's "crons" array, e.g.:
#   { "path": "/api/cron/workflow-automations", "schedule": "*/5 * * * *" }
# Vercel Cron only ever invokes this same endpoint; it holds no logic of its own.

# How many seconds a signed webhook delivery stays valid after its
# X-Automation-Timestamp — protects against replaying an old, captured request.
AUTOMATION_WEBHOOK_SIGNING_WINDOW_SECONDS="300"
# Maximum accepted incoming webhook body size, in bytes.
AUTOMATION_MAX_WEBHOOK_BODY_BYTES="262144"
# Minimum allowed interval (in minutes) between occurrences of a recurring
# schedule — a purely technical floor (the cron batch cadence can't reliably
# guarantee anything tighter), never a commercial/plan-based limit.
AUTOMATION_MIN_SCHEDULE_INTERVAL_MINUTES="5"
# How many due schedules/events/retries/waits are claimed per processing batch
# (cron invocation or dev driver run).
AUTOMATION_PROCESSING_BATCH_SIZE="50"

# --- Performance Intelligence (Fase 34) ---------------------------------------
# Purely technical ceilings (never a commercial/plan-based limit) — safe defaults
# apply when unset; override only if a real project genuinely needs a different
# ceiling for imports/comparisons/experiments.
PERFORMANCE_MAX_CSV_BYTES="10485760"
PERFORMANCE_MAX_JSON_BYTES="5242880"
PERFORMANCE_MAX_IMPORT_ROWS="20000"

# --- Integrations Hub: Google (GA4 + Search Console) — Fase 39 ---------------
# Real OAuth 2.0 authorization-code flow (server-side, offline access). Create
# an OAuth 2.0 Client ID (type "Web application") in Google Cloud Console >
# APIs & Services > Credentials, with the Analytics Data/Admin APIs and the
# Search Console API enabled on the project. Without these three set, the
# Integrations > Google page shows a real "configuración pendiente" screen —
# it never fakes a connection.
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
# Must exactly match a redirect URI registered on the OAuth Client, e.g.
# http://localhost:3000/api/integrations/google/callback in development.
GOOGLE_OAUTH_REDIRECT_URI=""
# Deliberately reuses ENCRYPTION_KEY above (src/lib/security/encryption.ts) —
# the same real AES-256-GCM authenticated-encryption utility already used for
# WordPress/GitHub credentials — rather than a second INTEGRATION_ENCRYPTION_KEY.
# Google refresh/access tokens and OAuth code_verifiers are encrypted through
# the SAME utility, now with an explicit format version (see encryptSecret's
# doc comment) so a future key rotation never breaks decrypting older rows.

# --- Branding ----------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="AI Content Hub"

# --- Optional / not required for the core app to run -------------------------
# STORAGE_PROVIDER=""
# SENTRY_DSN=""
